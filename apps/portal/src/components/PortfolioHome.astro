---
import HeroSignalStage from './HeroSignalStage.astro';
import ProjectMicroSchematic from './ProjectMicroSchematic.astro';
import ReadingTrackStepper from './ReadingTrackStepper.astro';
import {
  DECISION_STATUS_LABELS,
  DOMAIN_LABELS,
   getReadingMinutes,
  getReadingTracks,
  getRelatedTroubleshooting,
  loadKbData,
  safeExternalUrl,
  withBase,
  withDocRoute,
} from '../lib/kb-data';

const { catalog, stats, byId, allItems } = loadKbData();
const { counts } = stats;
const tierOrder = { core: 0, active: 1, archive: 2 };
const projects = [...catalog.projects].sort((a, b) => {
  return tierOrder[a.tier] - tierOrder[b.tier] || a.id.localeCompare(b.id);
});

const tierLabels: Record<string, string> = {
  core: 'Core',
  active: 'Active',
  archive: 'Archive',
};

const TOPIC_SHORT_LABELS: Record<string, string> = {
  'embedded-stream-framing': '串流边界',
  'ethernet-link-and-ip': '网口可达',
  'sensor-feedback-pipeline': '反馈时序',
  'task-and-bus-ownership': '总线所有权',
};

const SEVERITY_SHORT: Record<string, string> = {
  high: 'HIGH',
  medium: 'MED',
  low: 'LOW',
};

const projectById = new Map(catalog.projects.map((p) => [p.id, p]));
const topicById = new Map(catalog.topics.map((t) => [t.id, t]));
const adrById = new Map(catalog.adrs.map((a) => [a.id, a]));

const priorityTech = new Set([
  'STM32 HAL',
  'FreeRTOS',
  'Keil MDK',
  'LVGL',
  'lwIP',
  'SPI DMA',
  'USART DMA',
  'bxCAN',
  'TI DriverLib',
  'K230 MicroPython',
]);
const allTechEntries = Object.entries(stats.by_tech_stack || {}).sort(([a, ca], [b, cb]) => {
  if (cb !== ca) return cb - ca;
  const pa = priorityTech.has(a) ? 0 : 1;
  const pb = priorityTech.has(b) ? 0 : 1;
  return pa - pb || a.localeCompare(b);
});
const primaryTechs = allTechEntries.slice(0, 9);
const extraTechs = allTechEntries.slice(9);

const readingTracks = getReadingTracks(catalog);

interface LibraryEntry {
  id: string;
  codeBadge?: string;
  title: string;
  description: string;
  route: string;
  readingMinutes: number;
  mermaidCount: number;
  evidenceCount: number;
  meta?: string;
  metaTone?: 'danger' | 'accent' | 'neutral';
  phases?: string[];
  rootCause?: string;
  locatedBy?: string;
  relatedProjects: Array<{ id: string; title: string; href: string }>;
}

function mapRelatedProjects(ids: string[] = []) {
  return ids
    .map((pid) => {
      const p = projectById.get(pid);
      return p ? { id: pid, title: p.id, href: withDocRoute(p.route) } : null;
    })
    .filter((x): x is { id: string; title: string; href: string } => Boolean(x));
}

const groups: Array<{ id: string; label: string; colorClass: string; items: LibraryEntry[] }> = [
  {
    id: 'topics',
    label: '技术专题',
    colorClass: 'kb-type-topic',
    items: catalog.topics.map((t) => ({
      id: t.id,
      title: t.title,
      description: t.description,
      route: t.route,
      readingMinutes: getReadingMinutes(t),
      mermaidCount: t.mermaid_count ?? 0,
      evidenceCount: t.evidence_count ?? 0,
      meta: DOMAIN_LABELS[t.domain] || t.domain,
      metaTone: 'neutral',
      relatedProjects: mapRelatedProjects(t.related_projects),
    })),
  },
  {
    id: 'troubleshooting',
    label: '排障案例',
    colorClass: 'kb-type-troubleshooting',
    items: catalog.troubleshooting.map((ts) => ({
      id: ts.id,
      codeBadge: ts.ts_id,
      title: ts.title.replace(/^TS-\d+\s*·\s*/, ''),
      description: ts.description,
      route: ts.route,
      readingMinutes: getReadingMinutes(ts),
      mermaidCount: ts.mermaid_count ?? 0,
      evidenceCount: ts.evidence_count ?? 0,
      meta: SEVERITY_SHORT[ts.severity] || ts.severity,
      metaTone: ts.severity === 'high' ? 'danger' : 'neutral',
      phases: ts.phases,
      rootCause: ts.root_cause?.trim() || undefined,
      locatedBy: ts.located_by?.trim() || undefined,
      relatedProjects: mapRelatedProjects(ts.related_projects),
    })),
  },
  {
    id: 'adr',
    label: '架构决策',
    colorClass: 'kb-type-adr',
    items: catalog.adrs.map((a) => ({
      id: a.id,
      codeBadge: a.adr_id,
      title: a.title.replace(/^ADR-\d+\s*·\s*/, ''),
      description: a.description,
      route: a.route,
      readingMinutes: getReadingMinutes(a),
      mermaidCount: a.mermaid_count ?? 0,
      evidenceCount: a.evidence_count ?? 0,
      meta: DECISION_STATUS_LABELS[a.decision_status] || a.decision_status,
      metaTone: 'accent',
      relatedProjects: mapRelatedProjects(a.related_projects),
    })),
  },
  {
    id: 'synthesis',
    label: '综合复盘',
    colorClass: 'kb-type-synthesis',
    items: catalog.synthesis.map((s) => ({
      id: s.id,
      title: s.title,
      description: s.description,
      route: s.route,
      readingMinutes: getReadingMinutes(s),
      mermaidCount: s.mermaid_count ?? 0,
      evidenceCount: s.evidence_count ?? 0,
      meta: '横向对照',
      metaTone: 'accent',
      relatedProjects: mapRelatedProjects(s.related_projects),
    })),
  },
];

const latestUpdate = stats.recent_updates[0]?.updated;
const synthesis = catalog.synthesis[0];
const totalEvidence =
  counts.total_evidence_links ??
  allItems.reduce((sum, item) => sum + (item.evidence_count ?? 0), 0);
const totalMermaids =
  counts.total_mermaids ??
  allItems.reduce((sum, item) => sum + (item.mermaid_count ?? 0), 0);
const crossNotesCount = counts.topics + counts.adrs + counts.troubleshooting + counts.synthesis;

const heroDomains = [
  'STM32 · MSPM0',
  'FreeRTOS',
  'CAN / DMA',
  'lwIP',
  '40-bit SHA',
];
---

<div class="kb-home not-content">
  <!-- 1. Two-Column Visual Hero Workbench -->
  <section class="kb-hero-grid" aria-labelledby="_top">
    <div class="kb-hero-copy">
      <div class="kb-eyebrow">
        <span class="kb-eyebrow-pill">EMBEDDED ATLAS</span>
        <span>{catalog.owner}</span>
        {latestUpdate && (
          <time class="kb-eyebrow-date" datetime={latestUpdate}>· {latestUpdate}</time>
        )}
      </div>

      <h1 id="_top" class="kb-hero-title">
        动态信号脉络下的<span class="kb-title-highlight">嵌入式固件图谱</span>
      </h1>

      <div class="kb-hero-chips" aria-label="核心技术域">
        {heroDomains.map((tag, idx) => (
          <span class="kb-domain-pill" style={`--pill-idx: ${idx};`}>{tag}</span>
        ))}
      </div>

      <!-- Animated Bento Metric Tiles with Live Micro-Sparklines -->
      <div class="kb-metric-bento" aria-label="知识库核心指标">
        <div class="kb-metric-card kb-type-project">
          <div class="kb-metric-row">
            <span class="kb-metric-num" data-count-to={counts.projects}>{counts.projects}</span>
            <svg class="kb-metric-spark" viewBox="0 0 40 16" aria-hidden="true">
              <path d="M2,12 L10,12 L14,4 L24,4 L28,12 L38,12" pathLength="100" fill="none" />
            </svg>
          </div>
          <span class="kb-metric-label">固件工程</span>
        </div>

        <div class="kb-metric-card kb-type-topic">
          <div class="kb-metric-row">
            <span class="kb-metric-num" data-count-to={totalEvidence}>{totalEvidence}</span>
            <svg class="kb-metric-spark" viewBox="0 0 40 16" aria-hidden="true">
              <path d="M2,9 Q11,2 20,9 T38,9" pathLength="100" fill="none" />
            </svg>
          </div>
          <span class="kb-metric-label">源码锚点</span>
        </div>

        <div class="kb-metric-card kb-type-adr">
          <div class="kb-metric-row">
            <span class="kb-metric-num" data-count-to={totalMermaids}>{totalMermaids}</span>
            <svg class="kb-metric-spark" viewBox="0 0 40 16" aria-hidden="true">
              <path d="M2,13 L12,5 L22,11 L32,3 L38,7" pathLength="100" fill="none" />
            </svg>
          </div>
          <span class="kb-metric-label">架构时序图</span>
        </div>

        <div class="kb-metric-card kb-type-troubleshooting">
          <div class="kb-metric-row">
            <span class="kb-metric-num" data-count-to={crossNotesCount}>{crossNotesCount}</span>
            <svg class="kb-metric-spark" viewBox="0 0 40 16" aria-hidden="true">
              <path d="M2,11 L13,11 L17,3 L21,14 L25,8 L38,8" pathLength="100" fill="none" />
            </svg>
          </div>
          <span class="kb-metric-label">专题 · 排障</span>
        </div>
      </div>

      <div class="kb-actions">
        {synthesis && (
          <a class="kb-action kb-action--primary" href={withDocRoute(synthesis.route)}>
            <span>架构演进总览</span>
            <span class="kb-btn-arrow" aria-hidden="true">→</span>
          </a>
        )}
        <a class="kb-action" href={withBase('/graph/')}>
          <span class="kb-action-dot" aria-hidden="true"></span>
          关系图谱
        </a>
        <button type="button" class="kb-action kb-search-btn" data-trigger-search>
          检索 <kbd>Ctrl K</kbd>
        </button>
      </div>
    </div>

    <div class="kb-hero-visual">
      <HeroSignalStage />
    </div>
  </section>

  <!-- 2. Interactive Stepper Reading Tracks -->
  <section aria-labelledby="kb-tracks-heading" class="kb-tracks-section">
    <div class="kb-section-head">
      <div class="kb-section-title-row">
        <h2 id="kb-tracks-heading">阅读路线</h2>
        <span class="kb-section-tag">AUTO-CYCLE</span>
      </div>
    </div>
    <ReadingTrackStepper tracks={readingTracks} byId={byId} />
  </section>

  <!-- 3. Hardware Project Matrix with Live Micro-Schematics -->
  <section aria-labelledby="kb-projects" data-project-matrix>
    <div class="kb-section-head">
      <div class="kb-section-title-row">
        <h2 id="kb-projects">
          固件矩阵 <span class="kb-count-pill" data-project-count>{counts.projects}</span>
        </h2>
        <span class="kb-section-tag">LIVE SCHEMATICS</span>
      </div>
      <button type="button" class="kb-reset-filter" data-filter-reset hidden>
        重置 ✕
      </button>
    </div>

    <div class="kb-filter-bar" data-filter-bar hidden>
      <div class="kb-filter-group" role="group" aria-label="项目分级筛选">
        <button type="button" class="kb-filter-chip is-active" data-tier-filter="all">
          全部 ({counts.projects})
        </button>
        <button type="button" class="kb-filter-chip" data-tier-filter="core">
          Core ({stats.by_tier.core || 0})
        </button>
        {(stats.by_tier.active || 0) > 0 && (
          <button type="button" class="kb-filter-chip" data-tier-filter="active">
            Active ({stats.by_tier.active})
          </button>
        )}
        {(stats.by_tier.archive || 0) > 0 && (
          <button type="button" class="kb-filter-chip" data-tier-filter="archive">
            Archive ({stats.by_tier.archive})
          </button>
        )}
      </div>

      <div class="kb-filter-group kb-tech-filters" role="group" aria-label="技术栈筛选">
        {primaryTechs.map(([tech, count]) => (
          <button type="button" class="kb-filter-chip" data-tech-filter={tech}>
            {tech} <span class="kb-chip-count">{count}</span>
          </button>
        ))}
        {extraTechs.map(([tech, count]) => (
          <button
            type="button"
            class="kb-filter-chip kb-extra-tech"
            data-tech-filter={tech}
            hidden
          >
            {tech} <span class="kb-chip-count">{count}</span>
          </button>
        ))}
        {extraTechs.length > 0 && (
          <button type="button" class="kb-filter-more" data-toggle-extra-tech>
            +{extraTechs.length}
          </button>
        )}
      </div>
    </div>

    <div class="kb-project-grid">
      {projects.map((project) => {
        const relatedTroubleshooting = getRelatedTroubleshooting(project, catalog);
        const relatedLinks = [
          ...(project.related_topics || []).map((id) => {
            const topic = topicById.get(id);
            return topic
              ? {
                  label: TOPIC_SHORT_LABELS[id] || topic.title.slice(0, 6),
                  fullTitle: topic.title,
                  href: withDocRoute(topic.route),
                  kind: 'topic',
                }
              : null;
          }),
          ...(project.related_adrs || []).map((id) => {
            const adr = adrById.get(id);
            return adr
              ? { label: adr.adr_id, fullTitle: adr.title, href: withDocRoute(adr.route), kind: 'adr' }
              : null;
          }),
          ...relatedTroubleshooting.map((ts) => ({
            label: ts.ts_id,
            fullTitle: ts.title,
            href: withDocRoute(ts.route),
            kind: 'troubleshooting',
          })),
        ].filter(
          (item): item is { label: string; fullTitle: string; href: string; kind: string } =>
            Boolean(item),
        );

        const shortSha = (project.synced_commit || '').slice(0, 7);
        const mins = getReadingMinutes(project);
        const extraSpecs = (project.highlights || []).slice(1, 3);
        const visibleTechs = project.tech_stack.slice(0, 4);
        const hiddenTechCount = Math.max(0, project.tech_stack.length - visibleTechs.length);
        const projectRepoUrl = safeExternalUrl(project.repo_url);

        return (
          <article
            class="kb-project"
            data-project-card
            data-tier={project.tier}
            data-techs={JSON.stringify(project.tech_stack || [])}
          >
            <ProjectMicroSchematic project={project} />

            <div class="kb-project-heading">
              <h3>
                <a class="kb-project-primary-link" href={withDocRoute(project.route)}>
                  {project.title}
                </a>
              </h3>
              <div class="kb-project-flags">
                <span class={`kb-tier ${project.tier === 'core' ? 'is-core' : ''}`}>
                  {tierLabels[project.tier] || project.tier}
                </span>
                {shortSha && (
                  <span class="kb-sha" title={`同步提交 ${project.synced_commit}`}>@{shortSha}</span>
                )}
              </div>
            </div>

            {/* Smooth Hover-Expand Summary Drawer (Zero prose clutter at rest) */}
            <div class="kb-project-desc-drawer">
              <div class="kb-project-desc-inner">
                <p class="kb-project-description">{project.description}</p>
              </div>
            </div>

            {extraSpecs.length > 0 && (
              <div class="kb-project-specs" aria-label="关键硬件规格">
                {extraSpecs.map((sp) => (
                  <span class="kb-mini-spec" title={`${sp.label}: ${sp.value}`}>
                    <em>{sp.label}</em> {sp.value}
                  </span>
                ))}
              </div>
            )}

            <div class="kb-stack-tags" aria-label="项目技术栈">
              {visibleTechs.map((tech) => (
                <button
                  type="button"
                  class="kb-card-tech"
                  data-card-tech={tech}
                  title={`按 ${tech} 筛选`}
                >
                  {tech}
                </button>
              ))}
              {hiddenTechCount > 0 && (
                <span
                  class="kb-tech-overflow"
                  title={project.tech_stack.slice(4).join(' · ')}
                >
                  +{hiddenTechCount}
                </span>
              )}
            </div>

            {relatedLinks.length > 0 && (
              <div class="kb-project-related" aria-label="关联知识节点">
                {relatedLinks.map((link) => (
                  <a
                    class={`kb-rel-pill kb-type-${link.kind}`}
                    href={link.href}
                    title={link.fullTitle}
                  >
                    <span class="kb-rel-dot" aria-hidden="true"></span>
                    {link.label}
                  </a>
                ))}
              </div>
            )}

            <div class="kb-project-links">
              <span class="kb-read-cta">
                <span>档案 · {mins}m</span>
                <span class="kb-cta-arrow" aria-hidden="true">→</span>
              </span>
              <div class="kb-project-ext">
                <a
                  class="kb-muted-link"
                  href={`${withBase('/graph/')}?node=${encodeURIComponent(project.id)}`}
                  title={`在知识图谱中定位 ${project.title}`}
                >
                  图谱 ☍
                </a>
                {projectRepoUrl && (
                  <a
                    href={projectRepoUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`${project.title} 的 GitHub 仓库`}
                  >
                    GitHub ↗
                  </a>
                )}
              </div>
            </div>
          </article>
        );
      })}
    </div>
    <p class="kb-empty-filter" data-project-empty hidden>
      无匹配工程，点击右上角“重置”恢复全部。
    </p>
  </section>

  <!-- 4. Cross-Project Visual Bento Library -->
  <section aria-labelledby="kb-library" class="kb-library-section">
    <div class="kb-library-header">
      <div class="kb-section-title-row">
        <h2 id="kb-library">跨域沉淀</h2>
        <span class="kb-section-tag">BENTO INDEX</span>
      </div>

      <div class="kb-tabs" aria-labelledby="kb-library" hidden>
        {groups.map(({ id, label, colorClass, items }) => (
          <button
            type="button"
            id={`kb-tab-${id}`}
            class={colorClass}
            aria-controls={`kb-panel-${id}`}
          >
            <span class="kb-tab-dot" aria-hidden="true"></span>
            {label}
            <span class="kb-tab-badge">{items.length}</span>
          </button>
        ))}
      </div>
    </div>

    {groups.map(({ id, label, colorClass, items }) => (
      <div id={`kb-panel-${id}`} class={`kb-category ${colorClass}`}>
        <h3>{label}（{items.length}）</h3>
        <div class="kb-bento-list">
          {items.map((item) => {
            const isTs = id === 'troubleshooting';
            const evidencePct = Math.min(100, Math.max(16, item.evidenceCount * 11));
            return (
              <article class="kb-bento-card">
                <div class="kb-bento-top">
                  <div class="kb-bento-badges">
                    {item.codeBadge && <span class="kb-bento-code">{item.codeBadge}</span>}
                    {item.meta && (
                      <span class={`kb-bento-meta ${item.metaTone === 'danger' ? 'is-danger' : ''}`}>
                        {item.metaTone === 'danger' && <i class="kb-danger-pulse" aria-hidden="true"></i>}
                        {item.meta}
                      </span>
                    )}
                  </div>
                  <span class="kb-bento-stats">
                    {item.mermaidCount > 0 && <span>{item.mermaidCount}图 · </span>}
                    {item.readingMinutes}m
                  </span>
                </div>

                <h4 class="kb-bento-title">
                  <a class="kb-bento-primary-link" href={withDocRoute(item.route)}>
                    <span>{item.title}</span>
                    <span class="kb-bento-arrow" aria-hidden="true">→</span>
                  </a>
                </h4>

                {/* Non-TS cards show 1-line compact caption + animated telemetry bar */}
                {!isTs && (
                  <>
                    <p class="kb-bento-desc" title={item.description}>{item.description}</p>
                    {item.evidenceCount > 0 && (
                      <div class="kb-bento-meter" aria-label={`包含 ${item.evidenceCount} 处源码锚点`}>
                        <div class="kb-bento-meter-track">
                          <span class="kb-bento-meter-fill" style={`--meter-w: ${evidencePct}%;`}></span>
                        </div>
                        <span class="kb-bento-meter-num">{item.evidenceCount} 锚点</span>
                      </div>
                    )}
                  </>
                )}

                {/* Animated Diagnostic Scanner Pipeline for Troubleshooting items */}
                {item.phases && item.phases.length > 0 && (
                  <div class="kb-phase-strip" aria-label="故障排查阶段链路">
                    {item.phases.map((phase, pIdx) => (
                      <span class="kb-phase-pill" style={`--phase-idx: ${pIdx};`}>
                        <b>{pIdx + 1}</b> {phase}
                      </span>
                    ))}
                  </div>
                )}

                {/* Compact 1-line Root Cause & Locator Strip (expands smoothly on hover) */}
                {(item.rootCause || item.locatedBy) && (
                  <div class="kb-ts-digest" aria-label="故障根因与定位摘要">
                    {item.rootCause && (
                      <div class="kb-ts-digest-row is-cause" title={item.rootCause}>
                        <span class="kb-ts-digest-key">根因</span>
                        <p class="kb-ts-digest-val">{item.rootCause}</p>
                      </div>
                    )}
                    {item.locatedBy && (
                      <div class="kb-ts-digest-row is-locate" title={item.locatedBy}>
                        <span class="kb-ts-digest-key">判据</span>
                        <p class="kb-ts-digest-val">{item.locatedBy}</p>
                      </div>
                    )}
                  </div>
                )}

                {item.relatedProjects.length > 0 && (
                  <div class="kb-bento-foot">
                    {item.relatedProjects.map((proj) => (
                      <a class="kb-proj-mini-tag" href={proj.href}>{proj.title}</a>
                    ))}
                  </div>
                )}
              </article>
            );
          })}
        </div>
      </div>
    ))}
  </section>
</div>

<script>
  // 1. Trigger Starlight built-in search modal & platform shortcut hint
  const isMac = /Mac|iPhone|iPad|iPod/i.test(navigator.userAgent);
  document.querySelectorAll<HTMLButtonElement>('[data-trigger-search]').forEach((btn) => {
    if (isMac) {
      const kbd = btn.querySelector('kbd');
      if (kbd) kbd.textContent = '⌘K';
    }
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const slBtn = document.querySelector<HTMLButtonElement>('site-search button[data-open-modal]');
      if (slBtn) slBtn.click();
    });
  });

  // 2. Smooth Count-Up Animation for Hero Metric Tiles
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reducedMotion) {
    document.querySelectorAll<HTMLElement>('[data-count-to]').forEach((el) => {
      const target = Number(el.dataset.countTo || '0');
      if (!target || target <= 1) return;
      const duration = 760;
      const start = performance.now();
      const tick = (now: number) => {
        const progress = Math.min(1, (now - start) / duration);
        const eased = 1 - Math.pow(1 - progress, 3);
        el.textContent = String(Math.round(target * eased));
        if (progress < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    });
  }

  function runWithTransition(mutate: () => void) {
    const docWithVt = document as Document & {
      startViewTransition?: (cb: () => void) => unknown;
    };
    if (!reducedMotion && typeof docWithVt.startViewTransition === 'function') {
      docWithVt.startViewTransition(mutate);
    } else {
      mutate();
    }
  }

  // 3. Interactive Project Matrix Filtering with View Transitions & Stagger Pop
  const matrix = document.querySelector<HTMLElement>('[data-project-matrix]');
  if (matrix) {
    const filterBar = matrix.querySelector<HTMLElement>('[data-filter-bar]')!;
    const resetBtn = matrix.querySelector<HTMLButtonElement>('[data-filter-reset]')!;
    const countEl = matrix.querySelector<HTMLElement>('[data-project-count]')!;
    const emptyEl = matrix.querySelector<HTMLElement>('[data-project-empty]')!;
    const cards = Array.from(matrix.querySelectorAll<HTMLElement>('[data-project-card]'));
    const tierBtns = Array.from(matrix.querySelectorAll<HTMLButtonElement>('[data-tier-filter]'));
    const techBtns = Array.from(matrix.querySelectorAll<HTMLButtonElement>('[data-tech-filter]'));
    const cardTechBtns = Array.from(matrix.querySelectorAll<HTMLButtonElement>('[data-card-tech]'));
    const extraToggle = matrix.querySelector<HTMLButtonElement>('[data-toggle-extra-tech]');
    const extraChips = Array.from(matrix.querySelectorAll<HTMLButtonElement>('.kb-extra-tech'));

    let activeTier = 'all';
    let activeTech = '';
    let extraExpanded = false;

    function expandExtrasIfNeeded() {
      if (!activeTech || extraExpanded) return;
      const isExtra = extraChips.some((c) => c.dataset.techFilter === activeTech);
      if (isExtra) {
        extraExpanded = true;
        extraChips.forEach((c) => (c.hidden = false));
        if (extraToggle) extraToggle.textContent = '收起';
      }
    }

    function updateDomFilter(syncUrl = true, animateCards = false) {
      expandExtrasIfNeeded();
      let visibleCount = 0;

      for (const card of cards) {
        const tier = card.dataset.tier || '';
        const techs: string[] = JSON.parse(card.dataset.techs || '[]');
        const matchTier = activeTier === 'all' || tier === activeTier;
        const matchTech = !activeTech || techs.includes(activeTech);
        const show = matchTier && matchTech;
        card.hidden = !show;
        if (show) {
          if (animateCards && !reducedMotion) {
            card.style.setProperty('--filter-idx', String(visibleCount));
            card.classList.remove('is-pop-in');
            void card.offsetWidth;
            card.classList.add('is-pop-in');
          }
          visibleCount++;
        }
      }

      tierBtns.forEach((b) => {
        const on = b.dataset.tierFilter === activeTier;
        b.classList.toggle('is-active', on);
        b.setAttribute('aria-pressed', String(on));
      });

      techBtns.forEach((b) => {
        const on = b.dataset.techFilter === activeTech;
        b.classList.toggle('is-active', on);
        b.setAttribute('aria-pressed', String(on));
      });

      cardTechBtns.forEach((b) => {
        b.classList.toggle('is-active', Boolean(activeTech) && b.dataset.cardTech === activeTech);
      });

      const isFiltered = activeTier !== 'all' || Boolean(activeTech);
      countEl.textContent = isFiltered ? `${visibleCount}/${cards.length}` : String(cards.length);
      resetBtn.hidden = !isFiltered;
      emptyEl.hidden = visibleCount > 0;

      if (syncUrl) {
        const url = new URL(window.location.href);
        if (activeTier !== 'all') url.searchParams.set('tier', activeTier);
        else url.searchParams.delete('tier');
        if (activeTech) url.searchParams.set('tech', activeTech);
        else url.searchParams.delete('tech');
        window.history.replaceState(null, '', url);
      }
    }

    function applyFilter(syncUrl = true) {
      if (syncUrl) {
        runWithTransition(() => updateDomFilter(true, true));
      } else {
        updateDomFilter(false, false);
      }
    }

    const params = new URLSearchParams(window.location.search);
    const initTier = params.get('tier');
    const initTech = params.get('tech');
    if (initTier && tierBtns.some((b) => b.dataset.tierFilter === initTier)) {
      activeTier = initTier;
    }
    if (initTech && techBtns.some((b) => b.dataset.techFilter === initTech)) {
      activeTech = initTech;
    }

    tierBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        activeTier = btn.dataset.tierFilter || 'all';
        applyFilter();
      });
    });

    techBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const t = btn.dataset.techFilter || '';
        activeTech = activeTech === t ? '' : t;
        applyFilter();
      });
    });

    cardTechBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const t = btn.dataset.cardTech || '';
        activeTech = activeTech === t ? '' : t;
        applyFilter();
      });
    });

    resetBtn.addEventListener('click', () => {
      activeTier = 'all';
      activeTech = '';
      applyFilter();
    });

    if (extraToggle) {
      const labelClosed = extraToggle.textContent || '更多';
      extraToggle.addEventListener('click', () => {
        extraExpanded = !extraExpanded;
        extraChips.forEach((c) => (c.hidden = !extraExpanded));
        extraToggle.textContent = extraExpanded ? '收起' : labelClosed;
      });
    }

    filterBar.hidden = false;
    applyFilter(false);
  }

  // 4. Cross-project Library Pill Tabs with Animated Transitions
  const tablist = document.querySelector<HTMLElement>('.kb-tabs');
  if (tablist) {
    const tabs = Array.from(tablist.querySelectorAll('button'));
    const panels = tabs.map((tab) => document.getElementById(tab.getAttribute('aria-controls')!)!);

    function selectTab(active: number, animate = false) {
      const apply = () => {
        tabs.forEach((tab, index) => {
          const selected = index === active;
          tab.setAttribute('aria-selected', String(selected));
          tab.tabIndex = selected ? 0 : -1;
          panels[index].hidden = !selected;
        });
      };
      if (animate) runWithTransition(apply);
      else apply();
    }

    tablist.setAttribute('role', 'tablist');
    tabs.forEach((tab, index) => {
      tab.setAttribute('role', 'tab');
      panels[index].setAttribute('role', 'tabpanel');
      panels[index].setAttribute('aria-labelledby', tab.id);
      tab.addEventListener('click', () => selectTab(index, true));
      tab.addEventListener('keydown', (event) => {
        const nextIndex = {
          ArrowLeft: (index - 1 + tabs.length) % tabs.length,
          ArrowRight: (index + 1) % tabs.length,
          Home: 0,
          End: tabs.length - 1,
        }[event.key];
        if (nextIndex === undefined) return;
        event.preventDefault();
        selectTab(nextIndex, true);
        tabs[nextIndex].focus();
      });
    });

    const syncFromHash = () => {
      const rawHash = window.location.hash.replace(/^#/, '');
      if (!rawHash) return false;
      const idx = tabs.findIndex(
        (tab, i) =>
          tab.id === rawHash || panels[i].id === rawHash || `kb-panel-${rawHash}` === panels[i].id,
      );
      if (idx !== -1) {
        selectTab(idx, false);
        return true;
      }
      return false;
    };

    if (!syncFromHash()) {
      selectTab(0, false);
    }
    window.addEventListener('hashchange', syncFromHash);
    tablist.hidden = false;
  }
</script>

