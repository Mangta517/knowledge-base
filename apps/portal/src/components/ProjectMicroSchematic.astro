---
import type { ProjectItem } from '../lib/kb-data';
import { getProjectSignalFlow } from '../lib/kb-data';

interface Props {
  project: ProjectItem;
}

const { project } = Astro.props;
const steps = getProjectSignalFlow(project).slice(0, 4);
const primarySpec = project.highlights?.[0];
const mcuLabel = (project.mcu || project.primary_language || 'MCU').replace(/（.*?）/g, '');

// Deterministic phase offset so cards pulse organically instead of robotic unison
const hashNum = Array.from(project.id).reduce((acc, ch) => acc + ch.charCodeAt(0), 0);
const phaseDelay = `${-((hashNum % 7) * 0.42).toFixed(2)}s`;

// Domain-specific oscilloscope trace motif
const isNet = project.domains?.includes('networking') || project.id === 'iwip';
const isBoot = project.id === 'bootloader';
const isControl = project.id === 'flight' || project.id === 'mspm0g3507';
const wavePath = isNet
  ? 'M0,18 L20,18 L20,5 L40,5 L40,18 L60,18 L60,5 L80,5 L80,18 L100,18 L100,5 L120,5'
  : isBoot
    ? 'M0,18 L26,18 L34,4 L74,4 L82,18 L120,18'
    : isControl
      ? 'M0,12 Q15,1 30,12 T60,12 T90,12 T120,12'
      : 'M0,16 L16,16 L20,4 L26,20 L32,10 L52,10 L58,4 L64,18 L92,18 L98,6 L104,16 L120,16';
---

<div class="kb-schem kb-blueprint-canvas" style={`--schem-delay: ${phaseDelay};`} aria-hidden="true">
  <div class="kb-schem-meta">
    <span class="kb-schem-mcu">
      <i class="kb-schem-pin"></i>
      {mcuLabel}
    </span>
    {primarySpec && (
      <span class="kb-schem-spec">
        <strong>{primarySpec.value}</strong>
      </span>
    )}
  </div>

  <div class="kb-schem-stage">
    <svg class="kb-schem-svg" viewBox="0 0 360 36" preserveAspectRatio="none">
      <path d={wavePath} transform="translate(228, 2)" pathLength="100" class="kb-schem-wave-bg" fill="none" />
      <path d={wavePath} transform="translate(228, 2)" pathLength="100" class="kb-schem-wave" fill="none" />
      <line x1="14" y1="20" x2="346" y2="20" class="kb-schem-bus" />
      <line x1="14" y1="20" x2="346" y2="20" class="kb-schem-pulse" />
      <line x1="14" y1="20" x2="346" y2="20" pathLength="100" class="kb-schem-packet" />
    </svg>

    <div class="kb-schem-nodes">
      {steps.map((step, idx) => (
        <span class="kb-schem-chip" style={`--step-idx: ${idx};`}>
          <span class={`kb-schem-dot ${idx === 0 ? 'is-origin' : ''}`}></span>
          <span class="kb-schem-text">{step}</span>
        </span>
      ))}
    </div>
  </div>
</div>

<style>
  .kb-schem {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.42rem;
    padding: 0.56rem 0.76rem 0.62rem;
    margin: -0.9rem -1rem 0.15rem;
    border-bottom: 1px solid var(--kb-border);
    border-radius: 0.68rem 0.68rem 0 0;
    overflow: hidden;
  }

  .kb-schem-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.4rem;
    font-size: 0.68rem;
    line-height: 1.3;
  }

  .kb-schem-mcu {
    display: inline-flex;
    align-items: center;
    gap: 0.32rem;
    padding: 0.09rem 0.44rem;
    border-radius: 0.3rem;
    background: var(--kb-surface);
    border: 1px solid var(--kb-border);
    color: var(--kb-accent);
    font-family: var(--sl-font-mono);
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .kb-schem-pin {
    width: 0.38rem;
    height: 0.38rem;
    border-radius: 50%;
    background: var(--kb-accent);
    box-shadow: 0 0 0 2px var(--kb-project-soft);
    flex-shrink: 0;
    animation: kbPulseSoft 2.4s ease-in-out infinite;
    animation-delay: var(--schem-delay, 0s);
  }

  .kb-schem-spec {
    padding: 0.08rem 0.4rem;
    border-radius: 0.28rem;
    background: var(--kb-surface);
    border: 1px solid var(--kb-border);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .kb-schem-spec strong {
    color: var(--sl-color-gray-1);
    font-family: var(--sl-font-mono);
    font-size: 0.66rem;
    font-weight: 600;
  }

  .kb-schem-stage {
    position: relative;
    padding: 0.16rem 0;
  }

  .kb-schem-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .kb-schem-wave-bg {
    stroke: var(--kb-accent);
    stroke-width: 1;
    opacity: 0.12;
  }

  .kb-schem-wave {
    stroke: var(--kb-accent);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-dasharray: 32 68;
    opacity: 0.34;
    animation: kbSchemPacket 3.2s linear infinite;
    animation-delay: var(--schem-delay, 0s);
    transition: opacity 0.25s, stroke-width 0.25s;
  }

  .kb-schem-bus {
    stroke: var(--kb-border-strong);
    stroke-width: 1.5;
  }

  .kb-schem-pulse {
    stroke: var(--kb-accent);
    stroke-width: 2;
    stroke-dasharray: 6 5;
    opacity: 0.26;
    animation: kbDashFlow 1.5s linear infinite;
    transition: opacity 0.22s;
  }

  .kb-schem-packet {
    stroke: var(--kb-topic);
    stroke-width: 3.4;
    stroke-linecap: round;
    stroke-dasharray: 8 92;
    opacity: 0.68;
    animation: kbSchemPacket 2.7s linear infinite;
    animation-delay: var(--schem-delay, 0s);
    transition: opacity 0.22s, stroke-width 0.22s;
  }

  @keyframes kbSchemPacket {
    from {
      stroke-dashoffset: 100;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  /* Burst into high-frequency energized mode on hover/focus */
  :global(.kb-project:is(:hover, :focus-within)) .kb-schem-pulse {
    opacity: 0.95;
    animation-duration: 0.85s;
  }

  :global(.kb-project:is(:hover, :focus-within)) .kb-schem-packet {
    opacity: 1;
    stroke-width: 4.4;
    animation-duration: 1.1s;
  }

  :global(.kb-project:is(:hover, :focus-within)) .kb-schem-wave {
    opacity: 0.78;
    stroke-width: 1.9;
    animation-duration: 1.4s;
  }

  .kb-schem-nodes {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.24rem;
    overflow: hidden;
  }

  .kb-schem-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.22rem;
    min-width: 0;
    padding: 0.14rem 0.38rem;
    border-radius: 0.34rem;
    border: 1px solid var(--kb-border);
    background: var(--kb-surface);
    color: var(--sl-color-gray-2);
    font-size: 0.66rem;
    font-weight: 600;
    line-height: 1.28;
    white-space: nowrap;
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
    transition:
      border-color 0.2s calc(var(--step-idx) * 45ms),
      background-color 0.2s calc(var(--step-idx) * 45ms),
      color 0.2s calc(var(--step-idx) * 45ms),
      transform 0.2s calc(var(--step-idx) * 45ms);
  }

  .kb-schem-text {
    overflow: hidden;
    text-overflow: ellipsis;
  }

  :global(.kb-project:is(:hover, :focus-within)) .kb-schem-chip {
    border-color: color-mix(in srgb, var(--kb-accent) 58%, var(--kb-border));
    background: color-mix(in srgb, var(--kb-surface) 80%, var(--kb-project-soft));
    color: var(--sl-color-gray-1);
    transform: translateY(-1.5px);
  }

  .kb-schem-dot {
    width: 0.32rem;
    height: 0.32rem;
    border-radius: 50%;
    background: var(--kb-border-strong);
    flex-shrink: 0;
    transition: background-color 0.2s calc(var(--step-idx) * 45ms), transform 0.2s calc(var(--step-idx) * 45ms);
  }

  .kb-schem-dot.is-origin {
    background: var(--kb-topic);
    animation: kbPulseSoft 2.4s ease-in-out infinite;
  }

  :global(.kb-project:is(:hover, :focus-within)) .kb-schem-dot {
    background: var(--kb-accent);
    transform: scale(1.2);
  }
</style>
