---
import type { ProjectItem } from '../lib/kb-data';
import { getProjectSignalFlow } from '../lib/kb-data';

interface Props {
  project: ProjectItem;
}

const { project } = Astro.props;
const steps = getProjectSignalFlow(project).slice(0, 5);
const primarySpec = project.highlights?.[0];
const mcuLabel = project.mcu || project.primary_language || 'MCU';

// Pick subtle domain waveform motif for the schematic backdrop
const isNet = project.domains?.includes('networking') || project.id === 'iwip';
const isBoot = project.id === 'bootloader';
const isControl = project.id === 'flight' || project.id === 'mspm0g3507';
const wavePath = isNet
  ? 'M0,18 L24,18 L24,6 L48,6 L48,18 L72,18 L72,6 L96,6 L96,18 L120,18'
  : isBoot
    ? 'M0,18 L30,18 L38,5 L78,5 L86,18 L120,18'
    : isControl
      ? 'M0,13 Q18,2 36,13 T72,13 T108,13 L120,13'
      : 'M0,16 L18,16 L22,5 L28,20 L34,11 L52,11 L58,5 L64,18 L120,18';
---

<div class="kb-schem kb-blueprint-canvas" aria-hidden="true">
  <div class="kb-schem-meta">
    <span class="kb-schem-mcu">
      <i class="kb-schem-pin"></i>
      {mcuLabel}
    </span>
    {primarySpec && (
      <span class="kb-schem-spec">
        {primarySpec.label}: <strong>{primarySpec.value}</strong>
      </span>
    )}
  </div>

  <div class="kb-schem-stage">
    <svg class="kb-schem-svg" viewBox="0 0 360 36" preserveAspectRatio="none">
      <path d={wavePath} transform="translate(230, 2)" class="kb-schem-wave" fill="none" />
      <line x1="16" y1="20" x2="344" y2="20" class="kb-schem-bus" />
      <line x1="16" y1="20" x2="344" y2="20" class="kb-schem-pulse" />
    </svg>

    <div class="kb-schem-nodes">
      {steps.map((step, idx) => (
        <span class="kb-schem-chip" style={`--step-idx: ${idx};`}>
          <span class={`kb-schem-dot ${idx === 0 ? 'is-origin' : ''}`}></span>
          <span class="kb-schem-text">{step}</span>
        </span>
      ))}
    </div>
  </div>
</div>

<style>
  .kb-schem {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.48rem;
    padding: 0.62rem 0.78rem 0.68rem;
    margin: -0.95rem -1.05rem 0.2rem;
    border-bottom: 1px solid var(--kb-border);
    border-radius: 0.65rem 0.65rem 0 0;
    overflow: hidden;
  }

  .kb-schem-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.45rem;
    font-size: 0.69rem;
    line-height: 1.3;
  }

  .kb-schem-mcu {
    display: inline-flex;
    align-items: center;
    gap: 0.32rem;
    padding: 0.1rem 0.46rem;
    border-radius: 0.3rem;
    background: var(--kb-surface);
    border: 1px solid var(--kb-border);
    color: var(--kb-accent);
    font-family: var(--sl-font-mono);
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .kb-schem-pin {
    width: 0.38rem;
    height: 0.38rem;
    border-radius: 1px;
    background: var(--kb-accent);
    box-shadow: 0 0 0 2px var(--kb-project-soft);
    flex-shrink: 0;
  }

  .kb-schem-spec {
    color: var(--sl-color-gray-3);
    font-size: 0.68rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .kb-schem-spec strong {
    color: var(--sl-color-gray-1);
    font-family: var(--sl-font-mono);
    font-weight: 600;
  }

  .kb-schem-stage {
    position: relative;
    padding: 0.18rem 0;
  }

  .kb-schem-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .kb-schem-wave {
    stroke: var(--kb-accent);
    stroke-width: 1.1;
    opacity: 0.14;
    transition: opacity 0.25s;
  }

  .kb-schem-bus {
    stroke: var(--kb-border-strong);
    stroke-width: 1.6;
  }

  .kb-schem-pulse {
    stroke: var(--kb-accent);
    stroke-width: 2.2;
    stroke-dasharray: 7 5;
    opacity: 0;
    transition: opacity 0.22s;
  }

  /* Calm at rest; energize signal pulse & stagger IC nodes when parent card is hovered/focused */
  :global(.kb-project:is(:hover, :focus-within)) .kb-schem-pulse {
    opacity: 0.95;
    animation: kbDashFlow 0.95s linear infinite;
  }

  :global(.kb-project:is(:hover, :focus-within)) .kb-schem-wave {
    opacity: 0.32;
  }

  .kb-schem-nodes {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.28rem;
  }

  .kb-schem-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.16rem 0.44rem;
    border-radius: 0.35rem;
    border: 1px solid var(--kb-border);
    background: var(--kb-surface);
    color: var(--sl-color-gray-2);
    font-size: 0.68rem;
    font-weight: 600;
    line-height: 1.3;
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
    transition:
      border-color 0.2s calc(var(--step-idx) * 45ms),
      background-color 0.2s calc(var(--step-idx) * 45ms),
      color 0.2s calc(var(--step-idx) * 45ms),
      transform 0.2s calc(var(--step-idx) * 45ms);
  }

  :global(.kb-project:is(:hover, :focus-within)) .kb-schem-chip {
    border-color: color-mix(in srgb, var(--kb-accent) 55%, var(--kb-border));
    background: color-mix(in srgb, var(--kb-surface) 82%, var(--kb-project-soft));
    color: var(--sl-color-gray-1);
    transform: translateY(-1px);
  }

  .kb-schem-dot {
    width: 0.34rem;
    height: 0.34rem;
    border-radius: 50%;
    background: var(--kb-border-strong);
    flex-shrink: 0;
    transition: background-color 0.2s calc(var(--step-idx) * 45ms);
  }

  .kb-schem-dot.is-origin {
    background: var(--kb-topic);
    animation: kbPulseSoft 2.8s ease-in-out infinite;
  }

  :global(.kb-project:is(:hover, :focus-within)) .kb-schem-dot {
    background: var(--kb-accent);
  }
</style>
