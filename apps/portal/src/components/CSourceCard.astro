---
import path from 'node:path';
import {
  highlightCCode,
  renderHighlightedCLinesHtml,
  renderInlineCodeHtml,
} from '../lib/c-highlight.mjs';
import { TYPE_SHORT_LABELS, type ResolvedSourceAnchor } from '../lib/kb-data';

interface Props {
  anchor: ResolvedSourceAnchor;
  index?: number;
  compact?: boolean;
  hideDocId?: string;
}

const { anchor, index, compact = false, hideDocId } = Astro.props;

const filename = path.posix.basename(anchor.path);
const hasCode = Boolean(anchor.code && anchor.code.trim());
const highlighted = hasCode
  ? highlightCCode(anchor.code, {
      startLine: anchor.start_line ?? 1,
      highlightLines: anchor.highlight_lines,
    })
  : null;
const highlightedLinesHtml = highlighted ? renderHighlightedCLinesHtml(highlighted) : '';
const showBottomClose = Boolean(highlighted && highlighted.totalLines > 24);
const codePanelId = `c-code-${compact ? 'doc-' : ''}${anchor.id}`;
const lineRangeLabel =
  anchor.start_line && anchor.end_line
    ? anchor.start_line === anchor.end_line
      ? `L${anchor.start_line}`
      : `L${anchor.start_line}–L${anchor.end_line}`
    : highlighted
      ? `L${highlighted.startLine}–L${highlighted.endLine}`
      : '';

const summaryHtml = renderInlineCodeHtml(anchor.summary);
const detailItemsHtml = anchor.engineering_details.map((item) => renderInlineCodeHtml(item));
const visibleDocs = hideDocId
  ? anchor.related_docs.filter((r) => r.doc_id !== hideDocId)
  : anchor.related_docs;
const fileExtLabel = anchor.file_kind === 'header' ? '.h 头文件' : '.c 实现';
const highlightCount = highlighted
  ? highlighted.lines.filter((l) => l.isHighlighted).length
  : 0;
---

<article
  id={compact ? undefined : `anchor-${anchor.id}`}
  class={`kb-ev-card kb-cs-card kb-type-${anchor.primary_doc_type} ${hasCode ? 'has-inline-code' : 'is-pending-code'} ${compact ? 'is-compact' : ''}`}
  data-ev-item={compact ? undefined : 'walkthrough'}
  data-repo={anchor.repo.toLowerCase()}
  data-ext={anchor.file_kind}
  data-category={anchor.category || ''}
  data-types={anchor.doc_types.join(',')}
  data-has-code={hasCode ? '1' : '0'}
  data-search={anchor.search_key}
>
  <header class="kb-cs-head">
    <div class="kb-cs-badges">
      {typeof index === 'number' && (
        <span class="kb-cs-seq">#{String(index + 1).padStart(2, '0')}</span>
      )}
      <span class={`kb-cs-lang-pill ${anchor.file_kind === 'header' ? 'is-header' : 'is-source'}`}>
        {fileExtLabel}
      </span>
      {anchor.category && <span class="kb-cs-cat-pill">{anchor.category}</span>}
      {anchor.symbol && (
        <code class="kb-cs-symbol-pill" title={`核心 C 符号：${anchor.symbol}`}>
          {anchor.symbol}
        </code>
      )}
    </div>

    <div class="kb-cs-origin">
      <span class="kb-ev-repo-pill" title={`固定提交 ${anchor.commit}`}>
        {anchor.project_id || anchor.repo} · @{anchor.commit.slice(0, 7)}
      </span>
      {lineRangeLabel && <span class="kb-cs-line-pill">{lineRangeLabel}</span>}
    </div>
  </header>

  <div class="kb-cs-title-row">
    <h3 class="kb-cs-title">{anchor.title}</h3>
    <div class="kb-cs-path-line">
      <code class="kb-cs-path" title={anchor.path}>
        {anchor.path}
      </code>
      {!hasCode && (
        <a
          class="kb-ev-ext-link"
          href={anchor.url}
          target="_blank"
          rel="noopener noreferrer"
          title={`在 GitHub 固定提交 @${anchor.commit.slice(0, 8)} 中查看完整 C 源码`}
        >
          GitHub 原文 ↗
        </a>
      )}
    </div>
  </div>

  {(summaryHtml || detailItemsHtml.length > 0 || (anchor.symbols.length > 0 && !anchor.symbol)) && (
    <div class="kb-cs-explain">
      <div class="kb-cs-explain-head">
        <span class="kb-cs-explain-tag">工程细节精讲</span>
        {anchor.symbols.length > 0 && detailItemsHtml.length === 0 && (
          <div class="kb-cs-symbol-list" aria-label="涉及的 C 符号与常量">
            {anchor.symbols.slice(0, 5).map((sym) => (
              <code class="kb-cs-mini-sym">{sym}</code>
            ))}
          </div>
        )}
      </div>

      {summaryHtml && <p class="kb-cs-summary" set:html={summaryHtml} />}

      {detailItemsHtml.length > 0 && (
        <ol class="kb-cs-details">
          {detailItemsHtml.map((html, idx) => (
            <li>
              <span class="kb-cs-detail-num">{String(idx + 1).padStart(2, '0')}</span>
              <span class="kb-cs-detail-text" set:html={html} />
            </li>
          ))}
        </ol>
      )}
    </div>
  )}

  {highlighted ? (
    <div class="kb-cs-code-box is-collapsed" data-c-code-box>
      <div class="kb-cs-code-bar">
        <button
          type="button"
          class="kb-cs-code-trigger"
          data-c-toggle
          aria-expanded="false"
          aria-controls={codePanelId}
          title={`点击展开或收起 ${filename}（${highlighted.totalLines} 行）`}
        >
          <span class="kb-cs-chevron" aria-hidden="true">▸</span>
          <span class="kb-cs-code-lang">C</span>
          <span class="kb-cs-code-file" title={anchor.path}>{filename}</span>
          <span class="kb-cs-code-lines">
            {lineRangeLabel || `L${highlighted.startLine}–L${highlighted.endLine}`} · {highlighted.totalLines} 行
          </span>
          {highlightCount > 0 && (
            <span class="kb-cs-hl-badge" title="卡片已标亮核心工程逻辑行">
              重点 {highlightCount} 行
            </span>
          )}
        </button>

        <div class="kb-cs-code-actions">
          <button
            type="button"
            class="kb-cs-toggle-btn"
            data-c-toggle
            aria-expanded="false"
            aria-controls={codePanelId}
          >
            展开源码
          </button>
          <button
            type="button"
            class="kb-cs-action-btn"
            data-c-copy
            aria-label={`复制 ${filename} 的 C 源码片段`}
            title="复制当前截取的 C 源码"
          >
            复制 C 代码
          </button>
          <a
            class="kb-cs-ext-btn"
            href={anchor.url}
            target="_blank"
            rel="noopener noreferrer"
            title={`核对 GitHub 固定提交 @${anchor.commit.slice(0, 8)} 完整文件`}
          >
            GitHub ↗
          </a>
        </div>
      </div>

      <div id={codePanelId} class="kb-cs-code-body" data-c-code-body hidden>
        <div class="kb-cs-code-viewport" tabindex="0" aria-label={`${filename} C 语言源码截取片段`}>
          <pre class="kb-cs-pre"><code class="kb-cs-code" set:html={highlightedLinesHtml} /></pre>
        </div>

        {showBottomClose && (
          <div class="kb-cs-fold-bar">
            <button
              type="button"
              class="kb-cs-fold-btn"
              data-c-toggle
              aria-expanded="false"
              aria-controls={codePanelId}
            >
              收起源码 ↑
            </button>
          </div>
        )}
      </div>
    </div>
  ) : (
    <div class="kb-cs-code-pending">
      <span class="kb-cs-pending-dot" aria-hidden="true"></span>
      <span class="kb-cs-pending-text">
        内联 C 源码就绪位 · 待后端按 <code>@{anchor.commit.slice(0, 7)}</code> 截取真实行段后自动直出（无需跳转工程）
      </span>
    </div>
  )}

  {visibleDocs.length > 0 && (
    <footer class="kb-cs-docs" aria-label="关联知识文档章节">
      <span class="kb-cs-docs-label">关联文档</span>
      <div class="kb-cs-doc-pills">
        {visibleDocs.map((ref) => (
          <a
            class={`kb-ev-ref-pill kb-type-${ref.doc_type}`}
            href={ref.doc_href}
            title={ref.section ? `${ref.doc_title} · ${ref.section}` : ref.doc_title}
          >
            <span class="kb-cs-doc-tag">{TYPE_SHORT_LABELS[ref.doc_type]}</span>
            <span>{ref.doc_title}</span>
            {ref.section && <span class="kb-ev-ref-sec">§ {ref.section}</span>}
          </a>
        ))}
      </div>
    </footer>
  )}
</article>

<style>
  .kb-cs-card {
    display: flex;
    flex-direction: column;
    gap: 0.62rem;
    padding: 0.85rem 1rem;
    border-radius: 0.74rem;
    border: 1px solid var(--kb-border);
    border-left: 3.5px solid var(--kb-type-color, var(--kb-accent));
    background: var(--kb-surface);
    box-shadow: var(--kb-card-specular), var(--kb-shadow-sm);
    transition: border-color 0.18s ease, background-color 0.18s ease, box-shadow 0.18s ease;
  }

  .kb-cs-card:hover {
    border-color: color-mix(in srgb, var(--kb-type-color, var(--kb-accent)) 60%, var(--kb-border));
    border-left-color: var(--kb-type-color, var(--kb-accent));
    box-shadow: var(--kb-card-specular), var(--kb-shadow-hover);
  }

  .kb-cs-card.is-compact {
    padding: 0.75rem 0.9rem;
    gap: 0.5rem;
  }

  .kb-cs-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.4rem 0.65rem;
  }

  .kb-cs-badges,
  .kb-cs-origin {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.34rem;
    min-width: 0;
  }

  .kb-cs-seq {
    color: var(--sl-color-gray-4);
    font-family: var(--sl-font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .kb-cs-lang-pill {
    padding: 0.08rem 0.46rem;
    border-radius: 0.3rem;
    font-family: var(--sl-font-mono);
    font-size: 0.67rem;
    font-weight: 700;
    letter-spacing: 0.01em;
  }

  .kb-cs-lang-pill.is-source {
    background: var(--kb-project-soft);
    color: var(--kb-project-ink);
  }

  .kb-cs-lang-pill.is-header {
    background: var(--kb-topic-soft);
    color: var(--kb-topic-ink);
  }

  .kb-cs-cat-pill {
    padding: 0.08rem 0.48rem;
    border-radius: 999px;
    background: var(--kb-adr-soft);
    color: var(--kb-adr-ink);
    font-size: 0.68rem;
    font-weight: 650;
  }

  .kb-cs-symbol-pill {
    padding: 0.08rem 0.48rem;
    border-radius: 0.32rem;
    border: 1px solid color-mix(in srgb, var(--kb-accent) 32%, var(--kb-border));
    background: var(--kb-surface-elevated);
    color: var(--sl-color-white);
    font-family: var(--sl-font-mono);
    font-size: 0.71rem;
    font-weight: 600;
  }

  .kb-ev-repo-pill {
    padding: 0.08rem 0.44rem;
    border-radius: 0.3rem;
    border: 1px solid var(--kb-border);
    background: var(--kb-surface-elevated);
    color: var(--sl-color-gray-2);
    font-family: var(--sl-font-mono);
    font-size: 0.68rem;
    white-space: nowrap;
  }

  .kb-cs-line-pill {
    padding: 0.08rem 0.42rem;
    border-radius: 0.3rem;
    background: var(--kb-synthesis-soft);
    color: var(--kb-synthesis-ink);
    font-family: var(--sl-font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .kb-cs-title-row {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .kb-cs-title {
    margin: 0;
    color: var(--sl-color-white);
    font-family: var(--kb-font-display);
    font-size: 0.98rem;
    font-weight: 700;
    line-height: 1.38;
  }

  .kb-cs-path-line {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.42rem;
  }

  .kb-cs-path {
    flex: 1 1 14rem;
    min-width: 0;
    padding: 0.16rem 0.5rem;
    border-radius: 0.36rem;
    border: 1px solid var(--kb-border);
    background: var(--kb-surface-elevated);
    color: var(--sl-color-gray-2);
    font-family: var(--sl-font-mono);
    font-size: 0.75rem;
    overflow-wrap: anywhere;
  }

  .kb-ev-ext-link {
    display: inline-flex;
    align-items: center;
    padding: 0.16rem 0.54rem;
    border-radius: 0.36rem;
    border: 1px solid color-mix(in srgb, var(--kb-accent) 42%, var(--kb-border));
    background: var(--kb-project-soft);
    color: var(--kb-project-ink);
    font-size: 0.72rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition: border-color 0.16s ease, background-color 0.16s ease;
  }

  .kb-ev-ext-link:hover {
    border-color: var(--kb-accent);
    background: color-mix(in srgb, var(--kb-project-soft) 75%, var(--kb-accent));
  }

  .kb-cs-explain {
    display: flex;
    flex-direction: column;
    gap: 0.42rem;
    padding: 0.62rem 0.78rem;
    border-radius: 0.54rem;
    border: 1px solid color-mix(in srgb, var(--kb-border) 82%, transparent);
    background: var(--kb-surface-elevated);
  }

  .kb-cs-explain-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.35rem 0.5rem;
  }

  .kb-cs-explain-tag {
    color: var(--kb-accent);
    font-family: var(--kb-font-display);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.03em;
  }

  .kb-cs-symbol-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.28rem;
  }

  .kb-cs-mini-sym {
    padding: 0.05rem 0.36rem;
    border-radius: 0.26rem;
    border: 1px solid var(--kb-border);
    background: var(--kb-surface);
    color: var(--sl-color-gray-1);
    font-family: var(--sl-font-mono);
    font-size: 0.68rem;
  }

  .kb-cs-summary {
    margin: 0;
    color: var(--sl-color-gray-1);
    font-size: 0.855rem;
    line-height: 1.66;
  }

  .kb-cs-details {
    margin: 0.1rem 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.34rem;
  }

  .kb-cs-details li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: baseline;
    gap: 0.48rem;
    color: var(--sl-color-gray-2);
    font-size: 0.82rem;
    line-height: 1.6;
  }

  .kb-cs-detail-num {
    font-family: var(--sl-font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--kb-accent);
    font-variant-numeric: tabular-nums;
  }

  .kb-cs-code-box {
    position: relative;
    border-radius: 0.58rem;
    border: 1px solid var(--kb-border);
    background: var(--kb-c-bg);
    overflow: hidden;
  }

  .kb-cs-code-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.4rem 0.6rem;
    padding: 0.42rem 0.68rem;
    border-bottom: 1px solid var(--kb-border);
    background: var(--kb-c-bar);
  }

  .kb-cs-code-box.is-collapsed .kb-cs-code-bar {
    border-bottom-color: transparent;
  }

  .kb-cs-code-trigger {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.38rem;
    flex: 1 1 14rem;
    min-width: 0;
    padding: 0.08rem 0.22rem 0.08rem 0;
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .kb-cs-code-trigger:hover .kb-cs-code-file,
  .kb-cs-code-trigger:hover .kb-cs-chevron {
    color: var(--kb-accent);
  }

  .kb-cs-chevron {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 0.9rem;
    color: var(--sl-color-gray-3);
    font-size: 0.78rem;
    transition: transform 0.16s ease, color 0.15s ease;
    transform: rotate(90deg);
  }

  .kb-cs-code-box.is-collapsed .kb-cs-chevron {
    transform: rotate(0deg);
  }

  .kb-cs-code-actions {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.38rem;
  }

  .kb-cs-toggle-btn {
    display: inline-flex;
    align-items: center;
    padding: 0.16rem 0.56rem;
    border-radius: 0.34rem;
    border: 1px solid color-mix(in srgb, var(--kb-accent) 45%, var(--kb-border));
    background: var(--kb-project-soft);
    color: var(--kb-project-ink);
    font-family: var(--kb-font-sans);
    font-size: 0.7rem;
    font-weight: 650;
    cursor: pointer;
    transition: border-color 0.15s ease, background-color 0.15s ease, color 0.15s ease;
  }

  .kb-cs-toggle-btn:hover {
    border-color: var(--kb-accent);
    background: color-mix(in srgb, var(--kb-project-soft) 75%, var(--kb-accent));
  }

  .kb-cs-code-lang {
    padding: 0.05rem 0.36rem;
    border-radius: 0.24rem;
    background: var(--kb-accent);
    color: #ffffff;
    font-family: var(--sl-font-mono);
    font-size: 0.64rem;
    font-weight: 700;
  }

  .kb-cs-code-file {
    color: var(--sl-color-white);
    font-family: var(--sl-font-mono);
    font-size: 0.74rem;
    font-weight: 600;
  }

  .kb-cs-code-lines {
    color: var(--sl-color-gray-3);
    font-family: var(--sl-font-mono);
    font-size: 0.69rem;
    font-variant-numeric: tabular-nums;
  }

  .kb-cs-hl-badge {
    padding: 0.05rem 0.4rem;
    border-radius: 999px;
    background: var(--kb-adr-soft);
    color: var(--kb-adr-ink);
    font-size: 0.66rem;
    font-weight: 650;
  }

  .kb-cs-action-btn,
  .kb-cs-ext-btn {
    display: inline-flex;
    align-items: center;
    padding: 0.16rem 0.5rem;
    border-radius: 0.34rem;
    border: 1px solid var(--kb-border);
    background: var(--kb-surface);
    color: var(--sl-color-gray-2);
    font-family: var(--kb-font-sans);
    font-size: 0.7rem;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    transition: border-color 0.15s ease, color 0.15s ease, background-color 0.15s ease;
  }

  .kb-cs-action-btn:hover,
  .kb-cs-ext-btn:hover {
    border-color: var(--kb-accent);
    color: var(--kb-accent);
  }

  .kb-cs-action-btn.is-copied {
    border-color: var(--kb-topic);
    color: var(--kb-topic);
  }

  .kb-cs-code-body[hidden] {
    display: none;
  }

  .kb-cs-code-viewport {
    position: relative;
    overflow-x: auto;
    padding: 0.52rem 0;
  }

  .kb-cs-pre {
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    font-family: var(--sl-font-mono);
    font-size: 0.79rem;
    line-height: 1.62;
    tab-size: 4;
    white-space: normal;
  }

  .kb-cs-code {
    display: block;
    min-width: max-content;
    font-family: inherit;
    background: transparent;
    color: var(--sl-color-gray-1);
    white-space: normal;
  }

  .kb-cs-card.is-jump-flash {
    border-color: var(--kb-accent);
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--kb-accent) 32%, transparent), var(--kb-shadow-hover);
  }

  .kb-cs-fold-bar {
    display: flex;
    justify-content: center;
    padding: 0.36rem 0.65rem;
    border-top: 1px solid var(--kb-border);
    background: var(--kb-c-bar);
  }

  .kb-cs-fold-btn {
    padding: 0.2rem 0.75rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--kb-accent) 40%, var(--kb-border));
    background: var(--kb-surface);
    color: var(--kb-accent);
    font: inherit;
    font-size: 0.72rem;
    font-weight: 650;
    cursor: pointer;
    transition: border-color 0.16s ease, background-color 0.16s ease;
  }

  .kb-cs-fold-btn:hover {
    border-color: var(--kb-accent);
    background: var(--kb-project-soft);
  }

  .kb-cs-code-pending {
    display: flex;
    align-items: center;
    gap: 0.48rem;
    padding: 0.42rem 0.68rem;
    border-radius: 0.48rem;
    border: 1px dashed color-mix(in srgb, var(--kb-accent) 36%, var(--kb-border));
    background: color-mix(in srgb, var(--kb-surface-elevated) 75%, transparent);
    color: var(--sl-color-gray-3);
    font-size: 0.74rem;
    line-height: 1.48;
  }

  .kb-cs-code-pending code {
    font-family: var(--sl-font-mono);
    font-size: 0.72rem;
    color: var(--sl-color-gray-1);
  }

  .kb-cs-pending-dot {
    width: 0.44rem;
    height: 0.44rem;
    border-radius: 50%;
    background: var(--kb-adr);
    flex-shrink: 0;
  }

  .kb-cs-docs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.36rem 0.5rem;
    padding-top: 0.12rem;
  }

  .kb-cs-docs-label {
    color: var(--sl-color-gray-3);
    font-size: 0.7rem;
    font-weight: 600;
  }

  .kb-cs-doc-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.32rem;
  }

  .kb-ev-ref-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.28rem;
