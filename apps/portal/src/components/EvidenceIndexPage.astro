---
import CSourceCard from './CSourceCard.astro';
import { renderInlineCodeHtml } from '../lib/c-highlight.mjs';
import {
  TYPE_LABELS,
  TYPE_SHORT_LABELS,
  getSourceAnchorCatalog,
  loadKbData,
  withBase,
  withDocRoute,
} from '../lib/kb-data';

const bundle = loadKbData();
const { catalog } = bundle;
const anchorCatalog = getSourceAnchorCatalog(bundle);
const {
  mode: dataMode,
  items: anchors,
  files: uniqueCFiles,
  inlineCodeCount,
  totalCodeLines,
  categories,
} = anchorCatalog;

const projectById = new Map(catalog.projects.map((p) => [p.id, p]));

// Aggregate strictly C-language (.c / .h) distribution per repository
const repoMap = new Map<
  string,
  {
    repo: string;
    projectId: string | null;
    projectTitle: string;
    projectHref: string | null;
    commit: string;
    count: number;
    inlineCount: number;
    uniqueFiles: Set<string>;
  }
>();

for (const anchor of anchors) {
  const key = anchor.repo.toLowerCase();
  let bucket = repoMap.get(key);
  if (!bucket) {
    const proj = anchor.project_id ? projectById.get(anchor.project_id) : undefined;
    bucket = {
      repo: anchor.repo,
      projectId: proj?.id || anchor.project_id || null,
      projectTitle: proj?.title || anchor.repo,
      projectHref: proj ? withDocRoute(proj.route) : null,
      commit: proj?.synced_commit || anchor.commit,
      count: 0,
      inlineCount: 0,
      uniqueFiles: new Set(),
    };
    repoMap.set(key, bucket);
  }
  bucket.count++;
  if (anchor.code && anchor.code.trim()) {
    bucket.inlineCount++;
  }
  bucket.uniqueFiles.add(anchor.url.split('#')[0]);
}

const repoSummaries = Array.from(repoMap.values()).sort(
  (a, b) => b.count - a.count || a.repo.localeCompare(b.repo),
);
const maxRepoCount = Math.max(1, ...repoSummaries.map((r) => r.count));

const docTypesOrder: Array<keyof typeof TYPE_LABELS> = [
  'project',
  'topic',
  'adr',
  'troubleshooting',
  'synthesis',
];
const typeCounts: Record<string, number> = {};
const coveredDocs = new Set<string>();
let cSourceCount = 0;
let cHeaderCount = 0;

for (const anchor of anchors) {
  if (anchor.file_kind === 'header') cHeaderCount++;
  else cSourceCount++;
  for (const t of anchor.doc_types) {
    typeCounts[t] = (typeCounts[t] || 0) + 1;
  }
  for (const ref of anchor.related_docs) {
    coveredDocs.add(ref.doc_id);
  }
}

const totalAnchors = anchors.length;
const totalUniqueCFiles = uniqueCFiles.length;
const hasAnyInlineCode = inlineCodeCount > 0;
const thirdStatNum =
  inlineCodeCount === totalAnchors && totalCodeLines > 0
    ? totalCodeLines
    : inlineCodeCount;
const thirdStatLabel =
  inlineCodeCount === totalAnchors && totalCodeLines > 0
    ? '直出 C 源码行数'
    : '已截取直出片段';
---

<div class="kb-evidence not-content" data-evidence-page data-c-code-scope>
  <div class="kb-subpage-top">
    <a class="kb-back-link" href={withBase('/')}>← 返回知识库总览</a>
    <div class="kb-subpage-nav">
      <a class="kb-subpage-pill" href={withBase('/diagrams/')}>架构时序图画廊</a>
      <a class="kb-subpage-pill" href={withBase('/graph/')}>知识关系图谱</a>
    </div>
  </div>

  <!-- C-Only Policy & Inline Excerpt Status Banner -->
  <div class={`kb-ev-scope-banner ${hasAnyInlineCode ? 'is-ready' : 'is-transition'}`}>
    <div class="kb-ev-scope-lead">
      <span class="kb-ev-c-badge">ONLY C · .c / .h</span>
      <p>
        本页严格仅收录公开固件仓固定 40 位 Git SHA 下的 <strong>C 语言源码（<code>.c</code> / <code>.h</code>）</strong>，已自动剔除工程配置、文档与脚本等非 C 文件，围绕源码直接拆解寄存器配置、状态机与并发控制细节。
      </p>
    </div>
    {!hasAnyInlineCode && (
      <p class="kb-ev-scope-note">
        当前处于前端 C 语境直出模式（已展示正文提取的工程说明与核心符号）；待后端按计划从固定提交切片写入 <code>catalog.json</code> 的 <code>source_anchors</code> 后，每张卡片将自动在此渲染带真实行号的 C 源码，无需跳出工程查看。
      </p>
    )}
    {hasAnyInlineCode && dataMode === 'curated' && (
      <p class="kb-ev-scope-note is-ready">
        已由后端固定快照直出 <strong>{inlineCodeCount}</strong> 段真实 C 源码（共 <strong>{totalCodeLines}</strong> 行），支持按文件、符号、代码关键字与工程分类即时检索。
      </p>
    )}
  </div>

  <!-- Summary Telemetry Strip (C-Only) -->
  <section class="kb-ev-summary" aria-label="C 语言源码精讲总览指标">
    <div class="kb-ev-stat-grid">
      <div class="kb-ev-stat kb-type-topic">
        <span class="kb-ev-stat-num">{totalAnchors}</span>
        <span class="kb-ev-stat-label">C 源码锚点</span>
      </div>
      <div class="kb-ev-stat kb-type-project">
        <span class="kb-ev-stat-num">{totalUniqueCFiles}</span>
        <span class="kb-ev-stat-label">覆盖 .c / .h 文件</span>
      </div>
      <div class="kb-ev-stat kb-type-adr">
        <span class="kb-ev-stat-num">{thirdStatNum}</span>
        <span class="kb-ev-stat-label">{thirdStatLabel}</span>
      </div>
      <div class="kb-ev-stat kb-type-synthesis">
        <span class="kb-ev-stat-num">{coveredDocs.size}</span>
        <span class="kb-ev-stat-label">关联知识文档</span>
      </div>
    </div>

    <div class="kb-ev-repo-bars" aria-label="各公开仓库 C 源码锚点分布">
      {repoSummaries.map((r) => {
        const pct = Math.max(8, Math.round((r.count / maxRepoCount) * 100));
        return (
          <button
            type="button"
            class="kb-ev-repo-row"
            data-ev-repo-btn={r.repo.toLowerCase()}
            aria-pressed="false"
            title={`点击筛选 ${r.repo}（${r.count} 处 C 源码锚点 / ${r.uniqueFiles.size} 个 .c/.h 文件）`}
          >
            <span class="kb-ev-repo-name">{r.projectId || r.repo}</span>
            <span class="kb-ev-repo-sha">@{r.commit.slice(0, 7)}</span>
            <span class="kb-ev-repo-track" aria-hidden="true">
              <span class="kb-ev-repo-fill" style={`width: ${pct}%;`}></span>
            </span>
            <span class="kb-ev-repo-count">
              {r.count} 处 · {r.uniqueFiles.size} 文件
            </span>
          </button>
        );
      })}
    </div>
  </section>

  <!-- Interactive Filter & View Toolbar -->
  <section class="kb-ev-toolbar" aria-label="C 源码筛选控制">
    <div class="kb-ev-toolbar-row">
      <div class="kb-ev-mode-switch" role="group" aria-label="列表聚合视图">
        <button
          type="button"
          class="kb-ev-mode-btn is-active"
          data-ev-mode="walkthrough"
          aria-pressed="true"
        >
          源码精讲 ({totalAnchors})
        </button>
        <button type="button" class="kb-ev-mode-btn" data-ev-mode="files" aria-pressed="false">
          按 C 文件聚合 ({totalUniqueCFiles})
        </button>
      </div>

      <div class="kb-ev-ext-switch" role="group" aria-label="按 C 文件后缀筛选">
        <button type="button" class="kb-ev-mode-btn is-active" data-ev-ext="all" aria-pressed="true">
          全部 C ({totalAnchors})
        </button>
        <button type="button" class="kb-ev-mode-btn" data-ev-ext="source" aria-pressed="false">
          .c 实现 ({cSourceCount})
        </button>
        <button type="button" class="kb-ev-mode-btn" data-ev-ext="header" aria-pressed="false">
          .h 头文件 ({cHeaderCount})
        </button>
      </div>

      <div class="kb-ev-search-wrap">
        {hasAnyInlineCode && (
          <button
            type="button"
            class="kb-ev-bulk-btn"
            data-c-toggle-all
            data-bulk-state="closed"
            aria-pressed="false"
            title="一键展开或收起当前筛选结果中的所有 C 代码块"
          >
            展开全部代码
          </button>
        )}
        <input
          type="search"
          class="kb-ev-search"
          placeholder="检索函数名、C 代码、文件路径或工程细节…"
          aria-label="筛选 C 源码精讲"
          data-ev-search
        />
        <span class="kb-ev-match-count" data-ev-count>
          显示 {totalAnchors} / {totalAnchors}
        </span>
        <button type="button" class="kb-ev-reset" data-ev-reset hidden>
          重置 ✕
        </button>
      </div>
    </div>

    {categories.length > 0 && (
      <div class="kb-ev-filter-row" role="group" aria-label="按工程机制分类筛选">
        <span class="kb-ev-filter-label">机制主题</span>
        <button type="button" class="kb-ev-chip is-active" data-ev-cat="all" aria-pressed="true">
          全部主题 ({totalAnchors})
        </button>
        {categories.map((cat) => (
          <button
            type="button"
            class="kb-ev-chip kb-type-adr"
            data-ev-cat={cat.name}
            aria-pressed="false"
          >
            <span class="kb-ev-dot" aria-hidden="true"></span>
            {cat.name} ({cat.count})
          </button>
        ))}
      </div>
    )}

    <div class="kb-ev-filter-row" role="group" aria-label="按关联文档类型筛选">
      <span class="kb-ev-filter-label">关联文档</span>
      <button type="button" class="kb-ev-chip is-active" data-ev-type="all" aria-pressed="true">
        全部类型 ({totalAnchors})
      </button>
      {docTypesOrder.map((t) => (
        <button
          type="button"
          class={`kb-ev-chip kb-type-${t}`}
          data-ev-type={t}
          aria-pressed="false"
        >
          <span class="kb-ev-dot" aria-hidden="true"></span>
          {TYPE_LABELS[t]} ({typeCounts[t] || 0})
        </button>
      ))}
    </div>
  </section>

  <!-- Mode 1: Inline C-Source Engineering Walkthrough Cards -->
  <div class="kb-ev-list" data-ev-panel="walkthrough">
    {anchors.map((anchor, idx) => (
      <CSourceCard anchor={anchor} index={idx} />
    ))}
  </div>

  <!-- Mode 2: Deduplicated Unique C Files (.c / .h) -->
  <div class="kb-ev-list" data-ev-panel="files" hidden>
    {uniqueCFiles.map((file) => (
      <article
        class="kb-ev-card kb-ev-file-card kb-type-project"
        data-ev-item="files"
        data-repo={file.repo.toLowerCase()}
        data-ext={file.fileKind}
        data-categories={file.categories.join(',')}
        data-types={file.docTypes.join(',')}
        data-search={file.searchKey}
      >
        <div class="kb-ev-card-head">
          <div class="kb-ev-card-meta">
            <span class={`kb-ev-kind ${file.fileKind === 'header' ? 'is-header' : 'is-source'}`}>
              {file.fileKind === 'header' ? '.H' : '.C'}
            </span>
            <code class="kb-ev-path" title={file.path}>
              {file.path}
            </code>
          </div>
          <div class="kb-ev-file-actions">
            <span class="kb-ev-ref-badge">{file.anchors.length} 处锚点</span>
            {file.inlineCodeCount > 0 && (
              <span class="kb-ev-code-badge">{file.inlineCodeCount} 段直出代码</span>
            )}
            <span class="kb-ev-repo-pill" title={`固定提交 ${file.commit}`}>
              {file.projectId || file.repo} · @{file.commit.slice(0, 7)}
            </span>
            <a
              class="kb-ev-ext-link"
              href={file.baseUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              GitHub ↗
            </a>
          </div>
        </div>

        <ul class="kb-ev-file-notes">
          {file.anchors.map((anchor) => {
            const lineLabel =
              anchor.start_line && anchor.end_line
                ? `L${anchor.start_line}–L${anchor.end_line}`
                : '';
            return (
              <li class="kb-ev-file-note">
                <div class="kb-ev-file-note-head">
                  <strong>{anchor.title}</strong>
                  {anchor.symbol && <code class="kb-ev-file-sym">{anchor.symbol}</code>}
                  {lineLabel && <span class="kb-ev-file-lines">{lineLabel}</span>}
                  {anchor.category && <span class="kb-ev-file-cat">{anchor.category}</span>}
                  <button
                    type="button"
                    class="kb-ev-file-jump"
                    data-ev-jump-anchor={anchor.id}
                    title={`切回精讲视图并定位到 ${anchor.title} 的内联 C 源码`}
                  >
                    看这段 C 源码 →
                  </button>
                </div>
                {anchor.summary && (
                  <p
                    class="kb-ev-file-summary"
                    set:html={renderInlineCodeHtml(anchor.summary)}
                  />
                )}
              </li>
            );
          })}
        </ul>

        <div class="kb-ev-ref-pills" aria-label="引用该 C 源码的知识文档">
          {file.docRefs.map((ref) => (
            <a
              class={`kb-ev-ref-pill kb-type-${ref.doc_type}`}
              href={ref.doc_href}
              title={ref.section ? `${ref.doc_title} · ${ref.section}` : ref.doc_title}
            >
              <span class="kb-ev-dot" aria-hidden="true"></span>
              <span class="kb-ev-ref-type">{TYPE_SHORT_LABELS[ref.doc_type]}</span>
              <span>{ref.doc_title}</span>
              {ref.section && <span class="kb-ev-ref-sec">§ {ref.section}</span>}
            </a>
          ))}
        </div>
      </article>
    ))}
  </div>

  <p class="kb-ev-empty" data-ev-empty hidden>
    没有匹配的 C 语言源码锚点，请放宽筛选条件或点击“重置”。
  </p>
</div>

<script>
  import { handleCCodeClick, setCodeBoxOpen, syncBulkToggle } from '../lib/c-code-controls';

  const page = document.querySelector<HTMLElement>('[data-evidence-page]');
  if (page) {
    const scopeEl: HTMLElement = page;
    scopeEl.dataset.cBound = '1';
    const modeBtns = Array.from(page.querySelectorAll<HTMLButtonElement>('[data-ev-mode]'));
    const extBtns = Array.from(page.querySelectorAll<HTMLButtonElement>('[data-ev-ext]'));
    const repoBtns = Array.from(page.querySelectorAll<HTMLButtonElement>('[data-ev-repo-btn]'));
    const catBtns = Array.from(page.querySelectorAll<HTMLButtonElement>('[data-ev-cat]'));
    const typeBtns = Array.from(page.querySelectorAll<HTMLButtonElement>('[data-ev-type]'));
    const searchInput = page.querySelector<HTMLInputElement>('[data-ev-search]')!;
    const countEl = page.querySelector<HTMLElement>('[data-ev-count]')!;
    const resetBtn = page.querySelector<HTMLButtonElement>('[data-ev-reset]')!;
    const emptyEl = page.querySelector<HTMLElement>('[data-ev-empty]')!;
    const walkthroughPanel = page.querySelector<HTMLElement>('[data-ev-panel="walkthrough"]')!;
    const filesPanel = page.querySelector<HTMLElement>('[data-ev-panel="files"]')!;
    const walkthroughItems = Array.from(
      page.querySelectorAll<HTMLElement>('[data-ev-item="walkthrough"]'),
    );
    const fileItems = Array.from(page.querySelectorAll<HTMLElement>('[data-ev-item="files"]'));

    let activeMode: 'walkthrough' | 'files' = 'walkthrough';
    let activeExt: 'all' | 'source' | 'header' = 'all';
    let activeRepo = '';
    let activeCat = 'all';
    let activeType = 'all';
    let query = '';

    // Hydrate initial filters from URL query
    const initParams = new URLSearchParams(window.location.search);
    if (initParams.get('mode') === 'files') activeMode = 'files';
    const initExt = initParams.get('ext') || 'all';
    if (initExt === 'source' || initExt === 'header') activeExt = initExt;
    const initRepo = (initParams.get('repo') || '').toLowerCase();
    if (initRepo && repoBtns.some((b) => b.dataset.evRepoBtn === initRepo)) {
      activeRepo = initRepo;
    }
    const initCat = initParams.get('cat') || 'all';
    if (catBtns.some((b) => b.dataset.evCat === initCat)) {
      activeCat = initCat;
    }
    const initType = initParams.get('type') || 'all';
    if (typeBtns.some((b) => b.dataset.evType === initType)) {
      activeType = initType;
    }
    const initQ = initParams.get('q') || '';
    if (initQ) {
      query = initQ;
      searchInput.value = initQ;
    }

    function applyFilters(syncUrl = true) {
      const q = query.trim().toLowerCase();
      const isFiles = activeMode === 'files';
      walkthroughPanel.hidden = isFiles;
      filesPanel.hidden = !isFiles;

      const list = isFiles ? fileItems : walkthroughItems;
      let visible = 0;

      for (const el of list) {
        const repoOk = !activeRepo || el.dataset.repo === activeRepo;
        const extOk = activeExt === 'all' || el.dataset.ext === activeExt;
        const itemCats = isFiles
          ? (el.dataset.categories || '').split(',').filter(Boolean)
          : el.dataset.category
            ? [el.dataset.category]
            : [];
        const catOk = activeCat === 'all' || itemCats.includes(activeCat);
        const itemTypes = (el.dataset.types || '').split(',').filter(Boolean);
        const typeOk = activeType === 'all' || itemTypes.includes(activeType);
        const queryOk = !q || (el.dataset.search || '').includes(q);
        const show = repoOk && extOk && catOk && typeOk && queryOk;
        el.hidden = !show;
        if (show) visible++;
      }

      modeBtns.forEach((btn) => {
        const on = btn.dataset.evMode === activeMode;
        btn.classList.toggle('is-active', on);
        btn.setAttribute('aria-pressed', String(on));
      });
      extBtns.forEach((btn) => {
        const on = btn.dataset.evExt === activeExt;
        btn.classList.toggle('is-active', on);
        btn.setAttribute('aria-pressed', String(on));
      });
      repoBtns.forEach((btn) => {
        const on = Boolean(activeRepo) && btn.dataset.evRepoBtn === activeRepo;
        btn.classList.toggle('is-active', on);
        btn.setAttribute('aria-pressed', String(on));
      });
      catBtns.forEach((btn) => {
        const on = btn.dataset.evCat === activeCat;
        btn.classList.toggle('is-active', on);
        btn.setAttribute('aria-pressed', String(on));
      });
      typeBtns.forEach((btn) => {
        const on = btn.dataset.evType === activeType;
        btn.classList.toggle('is-active', on);
        btn.setAttribute('aria-pressed', String(on));
      });

      const isFiltered =
        Boolean(activeRepo) ||
        activeExt !== 'all' ||
        activeCat !== 'all' ||
        activeType !== 'all' ||
        Boolean(q);
      countEl.textContent = `显示 ${visible} / ${list.length}`;
      resetBtn.hidden = !isFiltered;
      emptyEl.hidden = visible > 0;
      syncBulkToggle(scopeEl);

      if (syncUrl) {
        const url = new URL(window.location.href);
        if (activeMode === 'files') url.searchParams.set('mode', 'files');
        else url.searchParams.delete('mode');
        if (activeExt !== 'all') url.searchParams.set('ext', activeExt);
        else url.searchParams.delete('ext');
        if (activeRepo) url.searchParams.set('repo', activeRepo);
        else url.searchParams.delete('repo');
        if (activeCat !== 'all') url.searchParams.set('cat', activeCat);
        else url.searchParams.delete('cat');
        if (activeType !== 'all') url.searchParams.set('type', activeType);
        else url.searchParams.delete('type');
        if (q) url.searchParams.set('q', query.trim());
        else url.searchParams.delete('q');
        window.history.replaceState(null, '', url);
      }
    }

    modeBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        activeMode = btn.dataset.evMode === 'files' ? 'files' : 'walkthrough';
        applyFilters(true);
      });
    });

    extBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const val = btn.dataset.evExt;
        activeExt = val === 'source' || val === 'header' ? val : 'all';
        applyFilters(true);
      });
    });

    repoBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const next = btn.dataset.evRepoBtn || '';
        activeRepo = activeRepo === next ? '' : next;
        applyFilters(true);
      });
    });

    catBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        activeCat = btn.dataset.evCat || 'all';
        applyFilters(true);
      });
    });

    typeBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        activeType = btn.dataset.evType || 'all';
        applyFilters(true);
      });
    });

    searchInput.addEventListener('input', () => {
      query = searchInput.value;
      applyFilters(true);
    });

    resetBtn.addEventListener('click', () => {
      activeRepo = '';
      activeExt = 'all';
      activeCat = 'all';
      activeType = 'all';
      query = '';
      searchInput.value = '';
      applyFilters(true);
    });

    // Delegated C code toggle, bulk toggle, copy, and file-to-walkthrough jump handlers
    page.addEventListener('click', (event) => {
      const target = event.target as HTMLElement | null;
      if (!target) return;

      const jumpBtn = target.closest<HTMLButtonElement>('[data-ev-jump-anchor]');
      if (jumpBtn) {
        const anchorId = jumpBtn.dataset.evJumpAnchor || '';
        if (!anchorId) return;
        activeMode = 'walkthrough';
        applyFilters(true);
        const card = page.querySelector<HTMLElement>(`#anchor-${CSS.escape(anchorId)}`);
        if (card) {
          if (card.hidden) {
            activeRepo = '';
            activeExt = 'all';
            activeCat = 'all';
            activeType = 'all';
            query = '';
            searchInput.value = '';
            applyFilters(true);
          }
          const codeBox = card.querySelector<HTMLElement>('[data-c-code-box]');
          if (codeBox) {
            setCodeBoxOpen(codeBox, true);
            syncBulkToggle(scopeEl);
          }
          card.scrollIntoView({ behavior: 'smooth', block: 'center' });
          card.classList.add('is-jump-flash');
          window.setTimeout(() => card.classList.remove('is-jump-flash'), 1600);
        }
        return;
      }

      handleCCodeClick(scopeEl, target);
    });

    applyFilters(false);
  }
</script>

<style>
  .kb-evidence {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .kb-subpage-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .kb-back-link {
    color: var(--kb-accent);
    font-size: var(--sl-text-sm);
    font-weight: 600;
    text-decoration: none;
  }

  .kb-back-link:hover {
    text-decoration: underline;
  }

  .kb-subpage-nav {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .kb-subpage-pill {
