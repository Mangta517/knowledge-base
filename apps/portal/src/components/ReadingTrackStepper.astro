---
import type { KbDocItem, ReadingTrackData } from '../lib/kb-data';
import { TYPE_SHORT_LABELS, getReadingMinutes, withDocRoute } from '../lib/kb-data';

interface Props {
  tracks: ReadingTrackData[];
  byId: Map<string, KbDocItem>;
}

const { tracks, byId } = Astro.props;

const trackAccents = ['kb-type-project', 'kb-type-topic', 'kb-type-adr'];
---

<div class="kb-tracks-grid">
  {tracks.map((track, tIdx) => {
    const resolvedSteps = track.steps
      .map((s) => {
        const doc = byId.get(s.id);
        if (!doc) return null;
        return {
          id: s.id,
          role: s.role,
          focus: s.focus,
          title: doc.title,
          type: doc.type,
          typeShort: TYPE_SHORT_LABELS[doc.type],
          href: withDocRoute(doc.route),
          mins: getReadingMinutes(doc),
        };
      })
      .filter((x): x is NonNullable<typeof x> => Boolean(x));

    const accentClass = trackAccents[tIdx % trackAccents.length];

    return (
      <article
        class={`kb-track-card ${accentClass}`}
        data-track-stepper
        data-track-offset={tIdx}
      >
        <div class="kb-track-top">
          <span class="kb-track-idx">TRACK 0{tIdx + 1}</span>
          <span class="kb-track-count">{resolvedSteps.length} NODES</span>
        </div>

        <h3 title={track.summary}>{track.title}</h3>

        <!-- Animated Stepper Signal Rail with Glowing Runner Orb -->
        <div class="kb-stepper-rail-wrap">
          <div class="kb-stepper-line">
            <div class="kb-stepper-line-fill" data-stepper-fill style="width: 0%;"></div>
            <span class="kb-stepper-orb" data-stepper-orb style="left: 0%;" aria-hidden="true"></span>
          </div>
          <div class="kb-stepper-nodes" role="tablist" aria-label={`${track.title} 步骤节点`}>
            {resolvedSteps.map((step, sIdx) => (
              <button
                type="button"
                role="tab"
                id={`kb-track-${track.id}-tab-${sIdx}`}
                aria-controls={`kb-track-${track.id}-panel-${sIdx}`}
                tabindex={sIdx === 0 ? 0 : -1}
                class={`kb-step-btn kb-type-${step.type} ${sIdx === 0 ? 'is-active' : ''}`}
                aria-selected={sIdx === 0 ? 'true' : 'false'}
                data-step-trigger={sIdx}
                data-step-pct={
                  resolvedSteps.length > 1
                    ? Math.round((sIdx / (resolvedSteps.length - 1)) * 100)
                    : 100
                }
              >
                <span class="kb-step-num">{sIdx + 1}</span>
                <span class="kb-step-role">{step.role}</span>
              </button>
            ))}
          </div>
        </div>

        <!-- Compact Single-Line Progressive Focus Box -->
        <div class="kb-step-focus-box kb-blueprint-canvas">
          {resolvedSteps.map((step, sIdx) => (
            <div
              id={`kb-track-${track.id}-panel-${sIdx}`}
              role="tabpanel"
              aria-labelledby={`kb-track-${track.id}-tab-${sIdx}`}
              class={`kb-step-detail kb-type-${step.type}`}
              data-step-detail={sIdx}
              hidden={sIdx !== 0}
            >
              <div class="kb-step-detail-head">
                <span class="kb-step-kind">{step.typeShort}</span>
                <a class="kb-step-doc-link" href={step.href}>
                  {step.title}
                </a>
                <span class="kb-step-go">
                  {step.mins}m <span aria-hidden="true">→</span>
                </span>
              </div>
              <p class="kb-step-focus-text" title={step.focus}>{step.focus}</p>
            </div>
          ))}
        </div>
      </article>
    );
  })}
</div>

<script>
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-track-stepper]').forEach((card) => {
    const triggers = Array.from(card.querySelectorAll<HTMLButtonElement>('[data-step-trigger]'));
    const details = Array.from(card.querySelectorAll<HTMLElement>('[data-step-detail]'));
    const fill = card.querySelector<HTMLElement>('[data-stepper-fill]');
    const orb = card.querySelector<HTMLElement>('[data-stepper-orb]');
    const offsetIdx = Number(card.dataset.trackOffset || '0');

    let currentIdx = 0;
    let paused = false;

    function activate(idx: number) {
      currentIdx = idx;
      triggers.forEach((btn, i) => {
        const active = i === idx;
        const passed = i <= idx;
        btn.classList.toggle('is-active', active);
        btn.classList.toggle('is-passed', passed);
        btn.setAttribute('aria-selected', String(active));
        btn.tabIndex = active ? 0 : -1;
      });
      details.forEach((d, i) => {
        d.hidden = i !== idx;
      });
      const pct = triggers[idx]?.dataset.stepPct || '0';
      if (fill) fill.style.width = `${pct}%`;
      if (orb) orb.style.left = `${pct}%`;
    }

    triggers.forEach((btn, idx) => {
      btn.addEventListener('click', () => activate(idx));
      btn.addEventListener('mouseenter', () => activate(idx));
      btn.addEventListener('keydown', (e) => {
        const next = {
          ArrowLeft: (idx - 1 + triggers.length) % triggers.length,
          ArrowRight: (idx + 1) % triggers.length,
          Home: 0,
          End: triggers.length - 1,
        }[e.key];
        if (next !== undefined) {
          e.preventDefault();
          activate(next);
          triggers[next].focus();
        }
      });
    });

    card.addEventListener('mouseenter', () => (paused = true));
    card.addEventListener('mouseleave', () => (paused = false));
    card.addEventListener('focusin', () => (paused = true));
    card.addEventListener('focusout', (e) => {
      const next = e.relatedTarget as Node | null;
      paused = Boolean(next && card.contains(next));
    });

    activate(0);

    if (!reducedMotion && triggers.length > 1) {
      window.setTimeout(() => {
        window.setInterval(() => {
          if (!paused && !document.hidden) {
            activate((currentIdx + 1) % triggers.length);
          }
        }, 4200);
      }, offsetIdx * 1350);
    }
  });
</script>

<style>
  .kb-tracks-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20.5rem), 1fr));
    gap: 0.9rem;
  }

  .kb-track-card {
    display: flex;
    flex-direction: column;
    gap: 0.48rem;
    padding: 0.88rem 1rem;
    border: 1px solid var(--kb-border);
    border-radius: 0.78rem;
    background: var(--kb-surface);
    box-shadow: var(--kb-shadow-sm);
    transition: border-color 0.2s ease, background-color 0.2s ease, box-shadow 0.22s ease;
  }

  .kb-track-card:hover {
    border-color: color-mix(in srgb, var(--kb-type-color) 62%, var(--kb-border));
    background: color-mix(in srgb, var(--kb-surface) 93%, var(--kb-type-color));
    box-shadow: var(--kb-shadow-hover);
  }

  .kb-track-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.66rem;
    font-family: var(--sl-font-mono);
    letter-spacing: 0.03em;
  }

  .kb-track-idx {
    padding: 0.07rem 0.42rem;
    border-radius: 999px;
    background: var(--kb-type-soft);
    color: var(--kb-type-color);
    font-weight: 700;
  }

  .kb-track-count {
    color: var(--sl-color-gray-3);
  }

  .kb-track-card h3 {
    margin: 0;
    font-size: 0.98rem;
    color: var(--sl-color-white);
  }

  .kb-stepper-rail-wrap {
    position: relative;
    margin-top: 0.15rem;
    padding-top: 0.12rem;
  }

  .kb-stepper-line {
    position: relative;
    height: 3px;
    margin: 0.2rem 0.65rem 0.55rem;
    border-radius: 999px;
    background: var(--kb-surface-soft);
  }

  .kb-stepper-line-fill {
    height: 100%;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--kb-accent), var(--kb-topic), var(--kb-type-color));
    transition: width 0.36s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .kb-stepper-orb {
    position: absolute;
    top: 50%;
    width: 0.58rem;
    height: 0.58rem;
    border-radius: 50%;
    background: var(--kb-type-color);
    box-shadow: 0 0 0 3px var(--kb-type-soft);
    transform: translate(-50%, -50%);
    transition: left 0.36s cubic-bezier(0.22, 1, 0.36, 1);
    pointer-events: none;
  }

  .kb-stepper-nodes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.28rem;
  }

  .kb-step-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.24rem;
    padding: 0.16rem 0.44rem;
    border-radius: 999px;
    border: 1px solid var(--kb-border);
    background: var(--kb-surface-elevated);
    color: var(--sl-color-gray-2);
    font: inherit;
    font-size: 0.69rem;
    font-weight: 600;
    cursor: pointer;
    transition: border-color 0.18s, background 0.18s, color 0.18s;
  }

  .kb-step-btn.is-passed:not(.is-active) {
    border-color: color-mix(in srgb, var(--kb-type-color) 40%, var(--kb-border));
  }

  .kb-step-btn:hover,
  .kb-step-btn.is-active {
    border-color: var(--kb-type-color);
    background: var(--kb-type-soft);
    color: var(--kb-type-ink, var(--sl-color-gray-1));
  }

  .kb-step-num,
  .kb-step-role {
    pointer-events: none;
  }

  .kb-step-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 0.96rem;
    height: 0.96rem;
    border-radius: 50%;
    background: var(--kb-surface);
    color: var(--kb-type-ink, var(--kb-type-color));
    font-family: var(--sl-font-mono);
    font-size: 0.62rem;
    font-weight: 700;
  }

  .kb-step-focus-box {
    margin-top: auto;
    border-radius: 0.54rem;
    border: 1px solid var(--kb-border);
    transition: border-color 0.18s ease;
  }

  .kb-step-focus-box:hover {
    border-color: color-mix(in srgb, var(--kb-type-color) 55%, var(--kb-border));
  }

  .kb-step-focus-box:has(.kb-step-doc-link:focus-visible) {
    border-color: var(--kb-accent);
    outline: 2px solid var(--kb-accent);
    outline-offset: 2px;
  }

  .kb-step-detail:not([hidden]) {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.52rem 0.66rem;
    border-radius: inherit;
    animation: kbFadeSlideUp 0.2s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .kb-step-detail-head {
    display: flex;
    align-items: center;
    gap: 0.36rem;
    font-size: var(--sl-text-xs);
  }

  .kb-step-kind {
    padding: 0.05rem 0.36rem;
    border-radius: 0.24rem;
    background: var(--kb-type-soft);
    color: var(--kb-type-color);
    font-size: 0.64rem;
    font-weight: 700;
    flex-shrink: 0;
  }

  .kb-step-doc-link {
    color: var(--sl-color-white);
    font-weight: 600;
    text-decoration: none;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    transition: color 0.15s ease;
  }

  .kb-step-doc-link::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 2;
    border-radius: inherit;
  }

  .kb-step-doc-link:focus-visible {
    outline: none;
  }

  .kb-step-doc-link:is(:hover, :focus-visible) {
    color: var(--kb-accent);
  }

  .kb-step-go {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.16rem;
    color: var(--kb-accent);
    font-family: var(--sl-font-mono);
    font-size: 0.68rem;
    font-weight: 600;
    flex-shrink: 0;
  }

  .kb-step-go span {
    transition: transform 0.16s ease;
  }

  .kb-step-detail:has(.kb-step-doc-link:is(:hover, :focus-visible)) .kb-step-go span {
    transform: translateX(2px);
  }

  .kb-step-focus-text {
    margin: 0;
    min-height: calc(1.45em * 2);
    color: var(--sl-color-gray-3);
    font-size: 0.72rem;
    line-height: 1.45;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color 0.18s ease;
  }

  .kb-track-card:is(:hover, :focus-within) .kb-step-focus-text {
    color: var(--sl-color-gray-2);
  }
</style>
