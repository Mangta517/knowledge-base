---
import type { GraphNode } from '../lib/kb-data';
import {
  TYPE_LABELS,
  TYPE_SHORT_LABELS,
  getReadingMinutes,
  loadKbData,
  withBase,
  withDocRoute,
} from '../lib/kb-data';

const { graph, byId, neighborsById } = loadKbData();

const width = 960;
const height = 540;
const centerX = width / 2;
const centerY = height / 2;

const nodes = graph.nodes.map((node) => ({
  ...node,
  x: centerX,
  y: centerY,
  vx: 0,
  vy: 0,
  neighbors: new Set<string>(),
}));
type PositionedNode = (typeof nodes)[number];
const nodeById = new Map(nodes.map((node) => [node.id, node]));

// Deduplicate undirected visual edges while preserving whether a structural frontmatter bond exists
const pairMap = new Map<
  string,
  { source: PositionedNode; target: PositionedNode; kinds: Set<string> }
>();

for (const edge of graph.edges) {
  const source = nodeById.get(edge.source);
  const target = nodeById.get(edge.target);
  if (!source || !target || source === target) continue;
  source.neighbors.add(target.id);
  target.neighbors.add(source.id);
  const key = [source.id, target.id].sort().join('::');
  if (!pairMap.has(key)) {
    pairMap.set(key, { source, target, kinds: new Set() });
  }
  pairMap.get(key)!.kinds.add(edge.kind);
}

const edges = Array.from(pairMap.values()).map((e) => ({
  source: e.source,
  target: e.target,
  isStructural: e.kinds.has('frontmatter'),
}));

function placeRing(types: GraphNode['type'][], radiusX: number, radiusY: number, offset = 0) {
  const group = nodes.filter((node) => types.includes(node.type));
  group.forEach((node, index) => {
    const angle = offset + (2 * Math.PI * index) / Math.max(1, group.length);
    node.x += radiusX * Math.cos(angle);
    node.y += radiusY * Math.sin(angle);
  });
}

if (nodes.filter((node) => node.type === 'synthesis').length > 1) {
  placeRing(['synthesis'], 65, 50);
}
placeRing(['topic'], 185, 118, -Math.PI / 4);
placeRing(['project'], 335, 185, -Math.PI / 6);
placeRing(['adr', 'troubleshooting'], 415, 222, Math.PI / 7);

// Build-time deterministic elliptical force simulation
for (let iteration = 0; iteration < 180; iteration++) {
  const alpha = 1 - iteration / 180;
  for (let i = 0; i < nodes.length; i++) {
    const a = nodes[i];
    for (let j = i + 1; j < nodes.length; j++) {
      const b = nodes[j];
      const dx = (b.x - a.x) / 170;
      const dy = (b.y - a.y) / 78;
      const distance = Math.hypot(dx, dy) || 0.01;
      if (distance < 1.35) {
        const push = ((1.35 - distance) / distance) * 6.5 * alpha;
        const fx = dx * push * 1.15;
        const fy = dy * push * 0.85;
        a.vx -= fx;
        a.vy -= fy;
        b.vx += fx;
        b.vy += fy;
      }
    }
  }
  for (const { source, target } of edges) {
    const dx = target.x - source.x;
    const dy = target.y - source.y;
    const distance = Math.hypot(dx, dy) || 1;
    const force = (distance - 175) * 0.012 * alpha;
    const fx = (dx / distance) * force;
    const fy = (dy / distance) * force;
    source.vx += fx;
    source.vy += fy;
    target.vx -= fx;
    target.vy -= fy;
  }
  for (const node of nodes) {
    node.vx = (node.vx + (centerX - node.x) * 0.003 * alpha) * 0.75;
    node.vy = (node.vy + (centerY - node.y) * 0.005 * alpha) * 0.75;
    node.x = Math.max(98, Math.min(width - 98, node.x + node.vx));
    node.y = Math.max(42, Math.min(height - 48, node.y + node.vy));
  }
}

function shortLabel(node: PositionedNode) {
  let prefix = '';
  let label = node.title;
  let limit = 12;
  if (node.type === 'adr' || node.type === 'troubleshooting') {
    prefix = node.id.split('-').slice(0, 2).join('-') + ' ';
    label = node.title.split('·')[1]?.trim() || node.title;
    limit = 8;
  }
  if (label.length > limit) {
    label = label.slice(0, limit) + '…';
  }
  return prefix + label;
}

const typeCounts: Record<string, number> = {};
for (const n of nodes) {
  typeCounts[n.type] = (typeCounts[n.type] || 0) + 1;
}

const maxTypeCount = Math.max(1, ...Object.values(typeCounts));

// Serialize rich inspector payload for client-side selection panel
const inspectorPayload = Object.fromEntries(
  nodes.map((node) => {
    const doc = byId.get(node.id);
    const rels = neighborsById.get(node.id) || [];
    const flowSteps =
      doc?.type === 'project'
        ? doc.signal_flow || []
        : doc?.type === 'troubleshooting'
          ? doc.phases || []
          : [];
    const rootCause = doc?.type === 'troubleshooting' ? doc.root_cause?.trim() || '' : '';
    const locatedBy = doc?.type === 'troubleshooting' ? doc.located_by?.trim() || '' : '';
    const keywords = [
      node.id,
      node.title,
      doc?.description || '',
      rootCause,
      locatedBy,
      ...(doc?.tags || []),
      ...(doc?.type === 'project' ? doc.tech_stack || [] : []),
      ...flowSteps,
    ]
      .join(' ')
      .toLowerCase();

    return [
      node.id,
      {
        id: node.id,
        x: +node.x.toFixed(1),
        y: +node.y.toFixed(1),
        title: node.title,
        type: node.type,
        typeLabel: TYPE_LABELS[node.type],
        href: withDocRoute(node.route),
        description: doc?.description || '',
        readingMinutes: doc ? getReadingMinutes(doc) : 1,
        wordCount: doc?.word_count || 0,
        flowSteps,
        ...(rootCause ? { rootCause } : {}),
        ...(locatedBy ? { locatedBy } : {}),
        keywords,
        neighbors: rels.map((r) => ({
          id: r.item.id,
          title: r.item.title,
          type: r.item.type,
          typeShort: TYPE_SHORT_LABELS[r.item.type],
          href: withDocRoute(r.item.route),
          structural: r.kinds.includes('frontmatter'),
        })),
      },
    ];
  }),
);

const summary = `${nodes.length} NODES · ${edges.length} LINKS`;
---

<div class="kb-graph not-content" data-graph-payload={JSON.stringify(inspectorPayload)}>
  <div class="kb-graph-toolbar">
    <div class="kb-graph-filters" role="group" aria-label="节点类型筛选">
      <button type="button" data-graph-filter="all" aria-pressed="true">
        全部 ({nodes.length})
      </button>
      {Object.entries(TYPE_LABELS).map(([type, label]) => (
        <button type="button" data-graph-filter={type} aria-pressed="false">
          <span class={`kb-graph-dot kb-type-${type}`} aria-hidden="true"></span>
          {label} ({typeCounts[type] || 0})
        </button>
      ))}
    </div>

    <div class="kb-graph-tools">
      <input
        type="search"
        class="kb-graph-search"
        placeholder="检索节点 / 技术栈…"
        aria-label="按关键字定位图谱节点"
        data-graph-search
      />
      <div class="kb-graph-zoom-btns" role="group" aria-label="画布缩放控制">
        <button type="button" data-graph-zoom="out" title="缩小画布" aria-label="缩小">−</button>
        <button type="button" data-graph-zoom="reset" title="重置缩放与选中状态">复位</button>
        <button type="button" data-graph-zoom="in" title="放大画布" aria-label="放大">+</button>
      </div>
    </div>
  </div>

  <div class="kb-graph-workspace">
    <div class="kb-graph-stage-col">
      <div class="kb-graph-stage kb-blueprint-canvas" data-graph-stage>
        <svg viewBox={`0 0 ${width} ${height}`} aria-label="知识库节点关联图谱">
          <g data-graph-viewport>
            <g aria-hidden="true" class="kb-graph-orbits">
              <ellipse cx={centerX} cy={centerY} rx="185" ry="118" class="is-orbit-inner" />
              <ellipse cx={centerX} cy={centerY} rx="335" ry="185" class="is-orbit-mid" />
              <ellipse cx={centerX} cy={centerY} rx="425" ry="228" class="is-orbit-outer" />
            </g>

            <g aria-hidden="true">
              {edges.map(({ source, target, isStructural }, eIdx) => (
                <g>
                  <line
                    class={`kb-graph-edge ${isStructural ? 'is-solid' : 'is-dashed'}`}
                    x1={source.x.toFixed(1)}
                    y1={source.y.toFixed(1)}
                    x2={target.x.toFixed(1)}
                    y2={target.y.toFixed(1)}
                    data-source={source.id}
                    data-target={target.id}
                  />
                  {isStructural && (
                    <line
                      class="kb-graph-photon"
                      x1={source.x.toFixed(1)}
                      y1={source.y.toFixed(1)}
                      x2={target.x.toFixed(1)}
                      y2={target.y.toFixed(1)}
                      pathLength="100"
                      style={`--photon-delay: ${-((eIdx % 9) * 0.42).toFixed(2)}s;`}
                      data-photon-source={source.id}
                      data-photon-target={target.id}
                    />
                  )}
                </g>
              ))}
            </g>

            {nodes.map((node, nIdx) => {
              const radius = Math.min(16, 7.5 + Math.sqrt(node.neighbors.size) * 2.4);
              const isHub = node.type === 'synthesis' || node.neighbors.size >= 5;
              return (
                <a
                  class={`kb-graph-node kb-type-${node.type} ${isHub ? 'is-hub' : ''}`}
                  href={withDocRoute(node.route)}
                  aria-label={`${TYPE_LABELS[node.type]}：${node.title}`}
                  data-node-id={node.id}
                  data-node-type={node.type}
                  style={`--node-delay: ${Math.min(nIdx * 24, 360)}ms;`}
                  transform={`translate(${node.x.toFixed(1)}, ${node.y.toFixed(1)})`}
                >
                  <circle r={(radius + 5.5).toFixed(1)} class="kb-node-ring" />
                  <circle r={radius.toFixed(1)} class="kb-node-core" />
                  <text y={(radius + 15).toFixed(1)} text-anchor="middle">{shortLabel(node)}</text>
                </a>
              );
            })}
          </g>
        </svg>
      </div>

      <div class="kb-graph-legend">
        <span><i class="kb-legend-line is-solid"></i> 结构依赖</span>
        <span><i class="kb-legend-line is-dashed"></i> 双链引用</span>
        <span class="kb-legend-tip">单击锁定 · 双击打开 · 滚轮缩放</span>
      </div>
    </div>

    <aside class="kb-graph-inspector" aria-live="polite" data-graph-inspector>
      <div data-inspector-default>
        <div class="kb-inspector-status-row">
          <span class="kb-live-beacon" aria-hidden="true"></span>
          <p class="kb-inspector-title" data-inspector-summary data-default-summary={summary}>
            {summary}
          </p>
        </div>

        <!-- Visual Animated Distribution Bars instead of static prose -->
        <div class="kb-inspector-bars" aria-label="各类型节点占比">
          {Object.entries(TYPE_LABELS).map(([type, label], idx) => {
            const count = typeCounts[type] || 0;
            const pct = Math.round((count / maxTypeCount) * 100);
            return (
              <button
                type="button"
                class={`kb-dist-row kb-type-${type}`}
                data-quick-filter={type}
                style={`--bar-idx: ${idx}; --bar-pct: ${pct}%;`}
                title={`点击筛选 ${label}`}
              >
                <span class="kb-dist-label">{label}</span>
                <span class="kb-dist-track">
                  <span class="kb-dist-fill"></span>
                </span>
                <span class="kb-dist-num">{count}</span>
              </button>
            );
          })}
        </div>

        <p class="kb-inspector-desc" data-inspector-hint>
          悬停或单击节点点亮上下游脉冲链路
        </p>
      </div>

      <div data-inspector-detail hidden>
        <div class="kb-inspector-head">
          <span class="kb-inspector-badge" data-detail-badge></span>
          <button type="button" class="kb-inspector-clear" data-detail-clear aria-label="取消固定节点">
            解锁 ✕
          </button>
        </div>
        <h2 class="kb-detail-title" data-detail-title></h2>
        <div class="kb-detail-pills" data-detail-meta></div>
        <p class="kb-detail-desc" data-detail-desc></p>
        <div class="kb-detail-ts-box" data-detail-ts hidden></div>
        <div class="kb-detail-flow" data-detail-flow hidden></div>
        <a class="kb-detail-cta" data-detail-link href={withBase('/')}>打开文档 →</a>
        <div class="kb-detail-rels">
          <h3 data-detail-rel-heading>一跳脉络</h3>
          <ul data-detail-rel-list></ul>
        </div>
      </div>
    </aside>
  </div>
</div>

<script>
  interface NeighborItem {
    id: string;
    title: string;
    type: string;
    typeShort: string;
    href: string;
    structural: boolean;
  }
  interface NodePayload {
    id: string;
    x: number;
    y: number;
    title: string;
    type: string;
    typeLabel: string;
    href: string;
    description: string;
    readingMinutes: number;
    wordCount: number;
    flowSteps?: string[];
    rootCause?: string;
    locatedBy?: string;
    keywords: string;
    neighbors: NeighborItem[];
  }

  const root = document.querySelector<HTMLElement>('.kb-graph[data-graph-payload]');
  if (root) {
    const payload: Record<string, NodePayload> = JSON.parse(root.dataset.graphPayload || '{}');
    const getNodeInfo = (id: string | null | undefined): NodePayload | undefined =>
      id && Object.hasOwn(payload, id) ? payload[id] : undefined;

    const canonicalIdByLower = new Map<string, string>();
    for (const id of Object.keys(payload)) {
      canonicalIdByLower.set(id.toLowerCase(), id);
      const shortPrefix = id.match(/^(adr-\d+|ts-\d+)-/i);
      if (shortPrefix && !canonicalIdByLower.has(shortPrefix[1].toLowerCase())) {
        canonicalIdByLower.set(shortPrefix[1].toLowerCase(), id);
      }
    }
    const resolveNodeId = (raw: string | null | undefined): string | null => {
      if (!raw) return null;
      const trimmed = raw.trim();
      if (!trimmed) return null;
      if (Object.hasOwn(payload, trimmed)) return trimmed;
      return canonicalIdByLower.get(trimmed.toLowerCase()) || null;
    };

    const filterBtns = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-graph-filter]'));
    const quickFilterBtns = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-quick-filter]'));
    const searchInput = root.querySelector<HTMLInputElement>('[data-graph-search]')!;
    const zoomBtns = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-graph-zoom]'));
    const stage = root.querySelector<HTMLElement>('[data-graph-stage]')!;
    const svgEl = stage.querySelector<SVGSVGElement>('svg')!;
    const viewport = root.querySelector<SVGGElement>('[data-graph-viewport]')!;
    const nodes = Array.from(root.querySelectorAll<SVGAElement>('[data-node-id]'));
    const edges = Array.from(root.querySelectorAll<SVGLineElement>('[data-source]'));
    const photons = Array.from(root.querySelectorAll<SVGLineElement>('[data-photon-source]'));

    const defaultView = root.querySelector<HTMLElement>('[data-inspector-default]')!;
    const defaultSummaryEl = root.querySelector<HTMLElement>('[data-inspector-summary]')!;
    const defaultHintEl = root.querySelector<HTMLElement>('[data-inspector-hint]')!;
    const baseSummaryText = defaultSummaryEl.dataset.defaultSummary || defaultSummaryEl.textContent || '';
    const baseHintText = defaultHintEl.textContent || '';
    const detailView = root.querySelector<HTMLElement>('[data-inspector-detail]')!;
    const detailBadge = root.querySelector<HTMLElement>('[data-detail-badge]')!;
    const detailClear = root.querySelector<HTMLButtonElement>('[data-detail-clear]')!;
    const detailTitle = root.querySelector<HTMLElement>('[data-detail-title]')!;
    const detailMeta = root.querySelector<HTMLElement>('[data-detail-meta]')!;
    const detailDesc = root.querySelector<HTMLElement>('[data-detail-desc]')!;
    const detailTs = root.querySelector<HTMLElement>('[data-detail-ts]')!;
    const detailFlow = root.querySelector<HTMLElement>('[data-detail-flow]')!;
    const detailLink = root.querySelector<HTMLAnchorElement>('[data-detail-link]')!;
    const detailRelHeading = root.querySelector<HTMLElement>('[data-detail-rel-heading]')!;
    const detailRelList = root.querySelector<HTMLUListElement>('[data-detail-rel-list]')!;

    let selectedType = 'all';
    let searchQuery = '';
    let pinnedId: string | null = null;
    let hoveredId: string | null = null;

    // SVG Pan & Zoom state
    let scale = 1;
    let tx = 0;
    let ty = 0;
    let panning = false;
    let panMoved = false;
    let panStartX = 0;
    let panStartY = 0;
    let tweenRaf = 0;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function updateTransform() {
      viewport.setAttribute(
        'transform',
        `translate(${tx.toFixed(1)}, ${ty.toFixed(1)}) scale(${scale.toFixed(3)})`,
      );
    }

    function zoomAround(nextScaleRaw: number, focalX = 480, focalY = 270) {
      cancelAnimationFrame(tweenRaf);
      const nextScale = Math.min(2.8, Math.max(0.55, +nextScaleRaw.toFixed(3)));
      const ratio = nextScale / scale;
      tx = focalX - (focalX - tx) * ratio;
      ty = focalY - (focalY - ty) * ratio;
      scale = nextScale;
      updateTransform();
    }

    function smoothCenterNode(id: string) {
      const info = getNodeInfo(id);
      if (!info) return;
      cancelAnimationFrame(tweenRaf);
      const targetScale = Math.max(scale, 1.12);
      const focusX = 480 + (info.x - 480) * 0.65;
      const focusY = 270 + (info.y - 270) * 0.65;
      const targetTx = 480 - focusX * targetScale;
      const targetTy = 270 - focusY * targetScale;

      if (reducedMotion) {
        scale = targetScale;
        tx = targetTx;
        ty = targetTy;
        updateTransform();
        return;
      }

      const startScale = scale;
      const startTx = tx;
      const startTy = ty;
      const startTime = performance.now();
      const duration = 300;

      const step = (now: number) => {
        const t = Math.min(1, (now - startTime) / duration);
        const ease = 1 - Math.pow(1 - t, 3);
        scale = startScale + (targetScale - startScale) * ease;
        tx = startTx + (targetTx - startTx) * ease;
        ty = startTy + (targetTy - startTy) * ease;
        updateTransform();
        if (t < 1) tweenRaf = requestAnimationFrame(step);
      };
      tweenRaf = requestAnimationFrame(step);
    }

    function renderInspector(id: string | null, matchedCount = nodes.length, isFiltering = false) {
      const info = getNodeInfo(id);
      if (!info) {
        defaultView.hidden = false;
        detailView.hidden = true;
        if (isFiltering) {
          defaultSummaryEl.textContent = `MATCHED ${matchedCount} / ${nodes.length}`;
          defaultHintEl.textContent =
            matchedCount > 0 ? '点击高亮节点锁定脉络，或点“复位”全览' : '无匹配节点，请更换筛选条件';
        } else {
          defaultSummaryEl.textContent = baseSummaryText;
          defaultHintEl.textContent = baseHintText;
        }
        return;
      }
      defaultView.hidden = true;
      detailView.hidden = false;
      detailBadge.className = `kb-inspector-badge kb-type-${info.type}`;
      detailBadge.textContent = info.typeLabel;
      detailTitle.textContent = info.title;

      const pillTexts = [`${info.readingMinutes}m`, `${info.neighbors.length} 关联`];
      detailMeta.replaceChildren(
        ...pillTexts.map((txt) => {
          const s = document.createElement('span');
          s.className = 'kb-detail-stat';
          s.textContent = txt;
          return s;
        }),
      );

      detailDesc.textContent = info.description;
      detailDesc.title = info.description;
      detailLink.href = info.href;
      detailRelHeading.textContent = `一跳脉络 (${info.neighbors.length})`;

      const tsEntries: Array<{ label: string; text: string; tone: 'cause' | 'locate' }> = [];
      if (info.rootCause) {
        tsEntries.push({ label: '根因', text: info.rootCause, tone: 'cause' });
      }
      if (info.locatedBy) {
        tsEntries.push({ label: '判据', text: info.locatedBy, tone: 'locate' });
      }
      if (tsEntries.length > 0) {
        detailTs.hidden = false;
        detailTs.replaceChildren(
          ...tsEntries.map((entry) => {
            const row = document.createElement('div');
            row.className = `kb-detail-ts-row is-${entry.tone}`;
            row.title = entry.text;
            const key = document.createElement('span');
            key.className = 'kb-detail-ts-key';
            key.textContent = entry.label;
            const val = document.createElement('p');
            val.className = 'kb-detail-ts-val';
            val.textContent = entry.text;
            row.append(key, val);
            return row;
          }),
        );
      } else {
        detailTs.hidden = true;
        detailTs.replaceChildren();
      }

      const steps = info.flowSteps || [];
      if (steps.length > 0) {
        detailFlow.hidden = false;
        detailFlow.className = `kb-detail-flow kb-type-${info.type}`;
        detailFlow.replaceChildren(
          ...steps.map((s, idx) => {
            const chip = document.createElement('span');
            chip.className = 'kb-detail-flow-chip';
            chip.style.setProperty('--chip-idx', String(idx));
            chip.textContent = `${idx + 1} ${s}`;
            return chip;
          }),
        );
      } else {
        detailFlow.hidden = true;
        detailFlow.replaceChildren();
      }

      detailRelList.replaceChildren(
        ...info.neighbors.map((n) => {
          const li = document.createElement('li');
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'kb-rel-focus-btn';
          btn.title = '在图谱中聚焦此节点';
          const dotSpan = document.createElement('span');
          dotSpan.className = `kb-graph-dot kb-type-${n.type}`;
          const kindSpan = document.createElement('span');
          kindSpan.className = 'kb-rel-kind';
          kindSpan.textContent = n.typeShort;
          const nameSpan = document.createElement('span');
          nameSpan.className = 'kb-rel-name';
          nameSpan.textContent = n.title;
          btn.append(dotSpan, kindSpan, nameSpan);
          btn.addEventListener('click', () => {
            pinnedId = n.id;
            syncUrlNode(pinnedId);
            updateGraphState();
            smoothCenterNode(n.id);
          });

          const openLink = document.createElement('a');
          openLink.href = n.href;
          openLink.className = 'kb-rel-open';
          openLink.textContent = '→';
          openLink.title = `打开 ${n.title}`;
          li.append(btn, openLink);
          return li;
        }),
      );
    }

    function syncUrlNode(id: string | null) {
      const url = new URL(window.location.href);
      if (id) url.searchParams.set('node', id);
      else url.searchParams.delete('node');
      window.history.replaceState(null, '', url);
    }

    function applyTypeFilter(type: string) {
      selectedType = selectedType === type && type !== 'all' ? 'all' : type;
      pinnedId = null;
      syncUrlNode(null);
      filterBtns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.graphFilter === selectedType)));
      quickFilterBtns.forEach((b) =>
        b.classList.toggle('is-active', selectedType !== 'all' && b.dataset.quickFilter === selectedType),
      );
      updateGraphState();
    }

    function updateGraphState() {
      const focusId = hoveredId || pinnedId;
      const q = searchQuery.trim().toLowerCase();
      const matchedSet = new Set<string>();

      if (focusId) {
        matchedSet.add(focusId);
      } else {
        for (const node of nodes) {
          const id = node.dataset.nodeId!;
          const typeOk = selectedType === 'all' || node.dataset.nodeType === selectedType;
          const queryOk = !q || (getNodeInfo(id)?.keywords || '').includes(q);
          if (typeOk && queryOk) {
            matchedSet.add(id);
          }
        }
      }

      const filtering = Boolean(focusId) || selectedType !== 'all' || Boolean(q);
      const visible = new Set(matchedSet);

      for (const edge of edges) {
        const s = edge.dataset.source!;
        const t = edge.dataset.target!;
        const lit = focusId
          ? s === focusId || t === focusId
          : filtering && matchedSet.has(s) && matchedSet.has(t);
        edge.classList.toggle('is-lit', lit);
        if (focusId && lit) {
          visible.add(s);
          visible.add(t);
        }
        edge.classList.toggle('is-dim', filtering && !lit);
      }

      for (const photon of photons) {
        const s = photon.dataset.photonSource!;
        const t = photon.dataset.photonTarget!;
        const lit = focusId
          ? s === focusId || t === focusId
          : filtering && matchedSet.has(s) && matchedSet.has(t);
        photon.classList.toggle('is-lit', lit);
        photon.classList.toggle('is-dim', filtering && !lit);
      }

      for (const node of nodes) {
        const id = node.dataset.nodeId!;
        node.classList.toggle('is-pinned', id === pinnedId);
        node.classList.toggle('is-dim', filtering && !visible.has(id));
      }

      renderInspector(pinnedId || hoveredId, matchedSet.size, selectedType !== 'all' || Boolean(q));
    }

    // Hydrate ?node=<id> deep link (case-insensitive & safe against prototype keys)
    const resolvedUrlNode = resolveNodeId(new URLSearchParams(window.location.search).get('node'));
    if (resolvedUrlNode) {
      pinnedId = resolvedUrlNode;
      if (new URLSearchParams(window.location.search).get('node') !== resolvedUrlNode) {
        syncUrlNode(resolvedUrlNode);
      }
      smoothCenterNode(resolvedUrlNode);
    }

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => applyTypeFilter(btn.dataset.graphFilter!));
    });

    quickFilterBtns.forEach((btn) => {
      btn.addEventListener('click', () => applyTypeFilter(btn.dataset.quickFilter!));
    });

    searchInput.addEventListener('input', () => {
      searchQuery = searchInput.value;
      if (searchQuery.trim()) {
        pinnedId = null;
        syncUrlNode(null);
      }
      updateGraphState();
    });

    detailClear.addEventListener('click', () => {
      pinnedId = null;
      syncUrlNode(null);
      updateGraphState();
    });

    nodes.forEach((node) => {
      const id = node.dataset.nodeId!;
      node.addEventListener('mouseenter', () => {
        hoveredId = id;
        updateGraphState();
      });
      node.addEventListener('mouseleave', () => {
        hoveredId = null;
        updateGraphState();
      });
      node.addEventListener('focus', () => {
        hoveredId = id;
        updateGraphState();
      });
      node.addEventListener('blur', () => {
        hoveredId = null;
        updateGraphState();
      });
      node.addEventListener('click', (e) => {
        if (panMoved) {
          e.preventDefault();
          return;
        }
        if (e.metaKey || e.ctrlKey || pinnedId === id) {
          return;
        }
        e.preventDefault();
        pinnedId = id;
        syncUrlNode(id);
        updateGraphState();
      });
    });

    // Zoom & Pan interactions
    zoomBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const action = btn.dataset.graphZoom;
        if (action === 'in') {
          zoomAround(scale * 1.2);
        } else if (action === 'out') {
          zoomAround(scale / 1.2);
        } else {
          cancelAnimationFrame(tweenRaf);
          scale = 1;
          tx = 0;
          ty = 0;
          pinnedId = null;
          searchQuery = '';
          searchInput.value = '';
          selectedType = 'all';
          filterBtns.forEach((b) =>
            b.setAttribute('aria-pressed', String(b.dataset.graphFilter === 'all')),
          );
          quickFilterBtns.forEach((b) => b.classList.remove('is-active'));
          syncUrlNode(null);
          updateGraphState();
          updateTransform();
        }
      });
    });

    stage.addEventListener(
      'wheel',
      (e) => {
        e.preventDefault();
        const factor = e.deltaY < 0 ? 1.12 : 1 / 1.12;
        const rect = svgEl.getBoundingClientRect();
        const fx = rect.width > 0 ? ((e.clientX - rect.left) / rect.width) * 960 : 480;
        const fy = rect.height > 0 ? ((e.clientY - rect.top) / rect.height) * 540 : 270;
        zoomAround(scale * factor, fx, fy);
      },
      { passive: false },
    );

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && pinnedId && document.activeElement !== searchInput) {
        pinnedId = null;
        syncUrlNode(null);
        updateGraphState();
      }
    });

    stage.addEventListener('pointerdown', (e) => {
      if (e.button !== 0) return;
      if ((e.target as Element).closest('[data-node-id]')) {
        panMoved = false;
        return;
      }
      panning = true;
      panMoved = false;
      panStartX = e.clientX - tx;
      panStartY = e.clientY - ty;
      stage.setPointerCapture(e.pointerId);
      stage.classList.add('is-panning');
    });

    stage.addEventListener('pointermove', (e) => {
      if (!panning) return;
      const nx = e.clientX - panStartX;
      const ny = e.clientY - panStartY;
      if (Math.hypot(nx - tx, ny - ty) > 3) {
        panMoved = true;
      }
      tx = nx;
      ty = ny;
      updateTransform();
    });

    const stopPan = (e: PointerEvent) => {
      if (panning && !panMoved && !(e.target as Element).closest('[data-node-id]')) {
        pinnedId = null;
        syncUrlNode(null);
        updateGraphState();
      }
      panning = false;
      stage.classList.remove('is-panning');
    };
    stage.addEventListener('pointerup', stopPan);
    stage.addEventListener('pointercancel', () => {
      panning = false;
      stage.classList.remove('is-panning');
    });

    updateGraphState();
  }
</script>

