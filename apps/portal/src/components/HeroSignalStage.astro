---
import { withBase, withDocRoute } from '../lib/kb-data';

interface LayerSpec {
  index: number;
  tag: string;
  title: string;
  chips: string;
  insight: string;
  colorClass: string;
  links: Array<{ label: string; href: string; kind: string }>;
}

const layers: LayerSpec[] = [
  {
    index: 0,
    tag: 'L1 · 感知与物理层',
    title: '传感器采样与链路协商',
    chips: 'MPU6050 · K230 · LAN8720A · bxCAN',
    insight: '统一采样时基、坐标系单位与有效标志，隔离物理抖动与上层控制。',
    colorClass: 'kb-type-project',
    links: [
      { label: '传感器反馈链路', href: withDocRoute('/topics/embedded/sensor-feedback-pipeline/'), kind: 'topic' },
      { label: 'flight 飞控', href: withDocRoute('/projects/flight/'), kind: 'project' },
      { label: 'mspm0g3507', href: withDocRoute('/projects/mspm0g3507/'), kind: 'project' },
    ],
  },
  {
    index: 1,
    tag: 'L2 · 传输与组帧层',
    title: 'DMA 缓冲与消息边界重组',
    chips: 'UART IDLE · SPI DMA · CAN 分片 · pbuf',
    insight: '把零散字节流与 CAN 帧经长度、超时和 CRC 校验重组成原子消息。',
    colorClass: 'kb-type-topic',
    links: [
      { label: '串流消息边界', href: withDocRoute('/topics/embedded/embedded-stream-framing/'), kind: 'topic' },
      { label: 'bootloader', href: withDocRoute('/projects/bootloader/'), kind: 'project' },
      { label: 'iwip 以太网', href: withDocRoute('/projects/iwip/'), kind: 'project' },
    ],
  },
  {
    index: 2,
    tag: 'L3 · 并发与所有权层',
    title: 'RTOS 单任务总线与快照交接',
    chips: 'FreeRTOS · 互斥快照 · tcpip_thread',
    insight: '共享 I2C/外设收敛至单一任务上下文，通过快照与核心邮箱跨线程解耦。',
    colorClass: 'kb-type-synthesis',
    links: [
      { label: '任务与外设所有权', href: withDocRoute('/topics/embedded/task-and-bus-ownership/'), kind: 'topic' },
      { label: 'ADR-0002 总线独占', href: withDocRoute('/adr/ADR-0002-assign-sensor-bus-owner/'), kind: 'adr' },
      { label: 'watch 手表', href: withDocRoute('/projects/watch/'), kind: 'project' },
    ],
  },
  {
    index: 3,
    tag: 'L4 · 执行与恢复闭环',
    title: '控制输出、外部暂存与实板排障',
    chips: '串级 PID · LVGL · W25Q16+EEPROM',
    insight: '先暂存校验再提交状态，配合阶段化观测点快速定位冷启动与升级异常。',
    colorClass: 'kb-type-adr',
    links: [
      { label: 'ADR-0001 暂存提交', href: withDocRoute('/adr/ADR-0001-stage-image-before-boot/'), kind: 'adr' },
      { label: 'TS-0001 升级排查', href: withDocRoute('/troubleshooting/TS-0001-bootloader-update-phase/'), kind: 'troubleshooting' },
      { label: '全局关系图谱', href: withBase('/graph/'), kind: 'synthesis' },
    ],
  },
];
---

<div class="kb-stage-card kb-blueprint-canvas" data-hero-stage>
  <div class="kb-stage-topbar">
    <div class="kb-stage-status">
      <span class="kb-live-dot" aria-hidden="true"></span>
      <span>嵌入式信号闭环总览</span>
    </div>
    <span class="kb-stage-hint" data-stage-mode>自动巡检 · 悬停锁定层级</span>
  </div>

  <div class="kb-stage-svg-wrap">
    <svg viewBox="0 0 500 218" role="group" aria-label="四层嵌入式固件信号流交互拓扑图">
      <defs>
        <linearGradient id="kb-bus-grad" x1="0%" y1="0%" x2="100%" y2="0%">
          <stop offset="0%" stop-color="var(--kb-accent)" />
          <stop offset="50%" stop-color="var(--kb-topic)" />
          <stop offset="100%" stop-color="var(--kb-adr)" />
        </linearGradient>
      </defs>

      <!-- Feedback Closed-Loop Arc (L4 -> L1) -->
      <path
        d="M 432 136 C 432 188, 68 188, 68 136"
        class="kb-stage-feedback-base"
        fill="none"
      />
      <path
        d="M 432 136 C 432 188, 68 188, 68 136"
        class="kb-stage-feedback-pulse"
        data-stage-arc="3"
        fill="none"
      />
      <rect x="176" y="166" width="148" height="20" rx="10" class="kb-stage-arc-pill" />
      <text x="250" y="179.5" text-anchor="middle" class="kb-stage-arc-text">
        实板诊断与状态回执闭环 (TS)
      </text>

      <!-- Forward Signal Buses (0->1, 1->2, 2->3) -->
      {[0, 1, 2].map((idx) => {
        const x1 = 112 + idx * 121;
        const x2 = 139 + idx * 121;
        return (
          <g>
            <line x1={x1} y1="88" x2={x2} y2="88" class="kb-stage-bus-base" />
            <line
              x1={x1}
              y1="88"
              x2={x2}
              y2="88"
              class="kb-stage-bus-flow"
              data-stage-edge={idx}
            />
            <polygon
              points={`${x2 - 5},84 ${x2 + 1},88 ${x2 - 5},92`}
              class="kb-stage-bus-arrow"
              data-stage-arrow={idx}
            />
          </g>
        );
      })}

      <!-- 4 Interactive Architecture Layer Modules -->
      {
        [
          { idx: 0, x: 18, label: '感知与接口', sub1: 'IMU · K230', sub2: 'PHY · bxCAN', badge: 'L1', cls: 'kb-type-project' },
          { idx: 1, x: 139, label: 'DMA 组帧', sub1: 'IDLE / 环形区', sub2: '分片与 CRC', badge: 'L2', cls: 'kb-type-topic' },
          { idx: 2, x: 260, label: 'RTOS 所有权', sub1: '单任务总线', sub2: '快照 · 邮箱', badge: 'L3', cls: 'kb-type-synthesis' },
          { idx: 3, x: 381, label: '输出与提交', sub1: 'PID · LVGL', sub2: 'Flash · EEPROM', badge: 'L4', cls: 'kb-type-adr' },
        ].map((box) => (
          <g
            class={`kb-stage-node ${box.cls} ${box.idx === 0 ? 'is-active' : ''}`}
            data-stage-node={box.idx}
            tabindex="0"
            role="button"
            aria-label={`查看 ${box.badge} ${box.label} 详情`}
          >
            <rect x={box.x} y="34" width="96" height="106" rx="12" class="kb-stage-node-glow" />
            <rect x={box.x} y="34" width="96" height="106" rx="12" class="kb-stage-node-card" />
            <rect x={box.x + 10} y="44" width="28" height="17" rx="5" class="kb-stage-node-tag" />
            <text x={box.x + 24} y="55.5" text-anchor="middle" class="kb-stage-node-tag-text">
              {box.badge}
            </text>
            <circle cx={box.x + 80} cy="52.5" r="4" class="kb-stage-node-led" />
            <text x={box.x + 48} y="82" text-anchor="middle" class="kb-stage-node-title">
              {box.label}
            </text>
            <line x1={box.x + 12} y1="93" x2={box.x + 84} y2="93" class="kb-stage-node-sep" />
            <text x={box.x + 48} y="110" text-anchor="middle" class="kb-stage-node-sub">
              {box.sub1}
            </text>
            <text x={box.x + 48} y="126" text-anchor="middle" class="kb-stage-node-sub">
              {box.sub2}
            </text>
          </g>
        ))
      }
    </svg>
  </div>

  <!-- Synchronized Layer Switch Pills -->
  <div class="kb-stage-tabs" role="tablist" aria-label="架构层级切换">
    {layers.map((layer) => (
      <button
        type="button"
        role="tab"
        class={`kb-stage-tab ${layer.colorClass} ${layer.index === 0 ? 'is-active' : ''}`}
        aria-selected={layer.index === 0 ? 'true' : 'false'}
        data-stage-tab={layer.index}
      >
        <span class="kb-stage-tab-dot" aria-hidden="true"></span>
        {layer.tag.split('·')[1]?.trim()}
      </button>
    ))}
  </div>

  <!-- Compact Synchronized Detail Drawer -->
  <div class="kb-stage-drawer" aria-live="polite">
    {layers.map((layer) => (
      <div
        class={`kb-stage-panel ${layer.colorClass}`}
        data-stage-panel={layer.index}
        hidden={layer.index !== 0}
      >
        <div class="kb-stage-panel-head">
          <strong>{layer.title}</strong>
          <code>{layer.chips}</code>
        </div>
        <p class="kb-stage-panel-desc">{layer.insight}</p>
        <div class="kb-stage-panel-links">
          {layer.links.map((lnk) => (
            <a class={`kb-stage-chip kb-type-${lnk.kind}`} href={lnk.href}>
              <span class="kb-stage-chip-dot" aria-hidden="true"></span>
              {lnk.label} →
            </a>
          ))}
        </div>
      </div>
    ))}
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-hero-stage]').forEach((stage) => {
    const nodes = Array.from(stage.querySelectorAll<SVGGElement>('[data-stage-node]'));
    const tabs = Array.from(stage.querySelectorAll<HTMLButtonElement>('[data-stage-tab]'));
    const panels = Array.from(stage.querySelectorAll<HTMLElement>('[data-stage-panel]'));
    const edges = Array.from(stage.querySelectorAll<SVGLineElement>('[data-stage-edge]'));
    const arc = stage.querySelector<SVGPathElement>('[data-stage-arc]');
    const modeEl = stage.querySelector<HTMLElement>('[data-stage-mode]');

    let active = 0;
    let paused = false;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function setLayer(idx: number) {
      active = idx;
      nodes.forEach((n, i) => n.classList.toggle('is-active', i === idx));
      tabs.forEach((t, i) => {
        const on = i === idx;
        t.classList.toggle('is-active', on);
        t.setAttribute('aria-selected', String(on));
      });
      panels.forEach((p, i) => {
        p.hidden = i !== idx;
      });
      edges.forEach((edge, i) => {
        edge.classList.toggle('is-energized', i === idx || i === idx - 1);
      });
      if (arc) {
        arc.classList.toggle('is-energized', idx === 3 || idx === 0);
      }
    }

    nodes.forEach((node, idx) => {
      node.addEventListener('mouseenter', () => setLayer(idx));
      node.addEventListener('click', () => setLayer(idx));
      node.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          setLayer(idx);
        }
      });
    });

    tabs.forEach((tab, idx) => {
      tab.addEventListener('click', () => setLayer(idx));
      tab.addEventListener('mouseenter', () => setLayer(idx));
      tab.addEventListener('keydown', (e) => {
        const next = {
          ArrowLeft: (idx - 1 + tabs.length) % tabs.length,
          ArrowRight: (idx + 1) % tabs.length,
          Home: 0,
          End: tabs.length - 1,
        }[e.key];
        if (next !== undefined) {
          e.preventDefault();
          setLayer(next);
          tabs[next].focus();
        }
      });
    });

    stage.addEventListener('mouseenter', () => {
      paused = true;
      if (modeEl) modeEl.textContent = '已锁定检视 · 点击胶囊直达文档';
    });

    stage.addEventListener('mouseleave', () => {
      paused = false;
      if (modeEl) modeEl.textContent = '自动巡检 · 悬停锁定层级';
    });

    stage.addEventListener('focusin', () => {
      paused = true;
    });
    stage.addEventListener('focusout', () => {
      paused = false;
    });

    setLayer(0);

    if (!reducedMotion) {
      window.setInterval(() => {
        if (!paused && !document.hidden) {
          setLayer((active + 1) % 4);
        }
      }, 3800);
    }
  });
</script>

<style>
  .kb-stage-card {
    display: flex;
    flex-direction: column;
    gap: 0.62rem;
    padding: 0.88rem 1rem 0.95rem;
    border-radius: 0.85rem;
    border: 1px solid var(--kb-border);
    box-shadow: var(--kb-shadow-sm);
  }

  .kb-stage-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    font-size: var(--sl-text-xs);
  }

  .kb-stage-status {
    display: inline-flex;
    align-items: center;
    gap: 0.42rem;
    font-weight: 600;
    color: var(--sl-color-gray-1);
  }

  .kb-live-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--kb-topic);
    box-shadow: 0 0 0 3px var(--kb-topic-soft);
    animation: kbPulseSoft 2.4s ease-in-out infinite;
  }

  .kb-stage-hint {
    color: var(--sl-color-gray-3);
    font-size: 0.72rem;
  }

  .kb-stage-svg-wrap svg {
    display: block;
    width: 100%;
    height: auto;
    user-select: none;
  }

  .kb-stage-bus-base {
    stroke: var(--kb-border-strong);
    stroke-width: 2.2;
  }

  .kb-stage-bus-flow {
    stroke: url(#kb-bus-grad);
    stroke-width: 2.8;
    stroke-dasharray: 6 5;
    opacity: 0.38;
    animation: kbDashFlow 1.1s linear infinite;
    transition: opacity 0.2s, stroke-width 0.2s;
  }

  .kb-stage-bus-flow.is-energized {
    opacity: 1;
    stroke-width: 3.4;
  }

  .kb-stage-bus-arrow {
    fill: var(--kb-accent);
    opacity: 0.75;
  }

  .kb-stage-feedback-base {
    stroke: var(--kb-border);
    stroke-width: 1.5;
    stroke-dasharray: 4 4;
  }

  .kb-stage-feedback-pulse {
    stroke: var(--kb-troubleshooting);
    stroke-width: 1.8;
    stroke-dasharray: 6 6;
    opacity: 0.35;
    animation: kbDashFlow 1.4s linear infinite;
    transition: opacity 0.25s;
  }

  .kb-stage-feedback-pulse.is-energized {
    opacity: 0.92;
  }

  .kb-stage-arc-pill {
    fill: var(--kb-surface);
    stroke: var(--kb-border);
    stroke-width: 1;
  }

  .kb-stage-arc-text {
    fill: var(--sl-color-gray-3);
    font-size: 10px;
    font-weight: 500;
  }

  .kb-stage-node {
    cursor: pointer;
    outline: none;
  }

  .kb-stage-node-glow {
    fill: var(--kb-type-soft);
    opacity: 0;
    transition: opacity 0.22s;
  }

  .kb-stage-node-card {
    fill: var(--kb-surface);
    stroke: var(--kb-border);
    stroke-width: 1.35;
    transition: stroke 0.2s, stroke-width 0.2s, transform 0.2s;
  }

  .kb-stage-node:is(:hover, :focus-visible, .is-active) .kb-stage-node-glow {
    opacity: 0.95;
  }

  .kb-stage-node:is(:hover, :focus-visible, .is-active) .kb-stage-node-card {
    fill: color-mix(in srgb, var(--kb-surface) 78%, var(--kb-type-soft));
    stroke: var(--kb-type-color);
    stroke-width: 2;
  }

  .kb-stage-node-tag {
    fill: var(--kb-type-soft);
  }

  .kb-stage-node-tag-text {
    fill: var(--kb-type-color);
    font-family: var(--sl-font-mono);
    font-size: 9.5px;
    font-weight: 700;
  }

  .kb-stage-node-led {
    fill: var(--kb-border-strong);
    transition: fill 0.2s;
  }

  .kb-stage-node.is-active .kb-stage-node-led {
    fill: var(--kb-type-color);
  }

  .kb-stage-node-title {
    fill: var(--sl-color-gray-1);
    font-size: 11.5px;
    font-weight: 700;
  }

  .kb-stage-node-sep {
    stroke: var(--kb-border);
    stroke-width: 1;
  }

  .kb-stage-node-sub {
    fill: var(--sl-color-gray-3);
    font-family: var(--sl-font-mono);
    font-size: 9.2px;
  }

  .kb-stage-tabs {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.35rem;
  }

  .kb-stage-tab {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.3rem;
    padding: 0.28rem 0.4rem;
    border-radius: 0.45rem;
    border: 1px solid var(--kb-border);
    background: var(--kb-surface);
    color: var(--sl-color-gray-2);
    font: inherit;
    font-size: 0.72rem;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: border-color 0.16s, background 0.16s, color 0.16s;
  }

  .kb-stage-tab.is-active,
  .kb-stage-tab:hover {
    border-color: var(--kb-type-color);
    background: var(--kb-type-soft);
    color: var(--kb-type-ink, var(--sl-color-gray-1));
  }

  .kb-stage-tab-dot {
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 50%;
    background: var(--kb-type-color);
    flex-shrink: 0;
    pointer-events: none;
  }

  .kb-stage-drawer {
    padding: 0.62rem 0.75rem;
    border-radius: 0.6rem;
    border: 1px solid var(--kb-border);
    background: var(--kb-surface);
    min-height: 5.2rem;
  }

  .kb-stage-panel:not([hidden]) {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    animation: kbFadeSlideUp 0.2s ease-out;
  }

  .kb-stage-panel-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.35rem;
  }

  .kb-stage-panel-head strong {
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-1);
  }

  .kb-stage-panel-head code {
    padding: 0.08rem 0.4rem;
    border-radius: 0.28rem;
    background: var(--kb-surface-elevated);
    color: var(--kb-type-color);
    font-family: var(--sl-font-mono);
    font-size: 0.68rem;
  }

  .kb-stage-panel-desc {
    margin: 0;
    color: var(--sl-color-gray-2);
    font-size: 0.76rem;
    line-height: 1.5;
  }

  .kb-stage-panel-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.1rem;
  }

  .kb-stage-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.28rem;
    padding: 0.12rem 0.48rem;
    border-radius: 999px;
    border: 1px solid var(--kb-border);
    background: var(--kb-surface-elevated);
    color: var(--sl-color-gray-1);
    font-size: 0.7rem;
    font-weight: 600;
    text-decoration: none;
    transition: border-color 0.15s, background 0.15s, color 0.15s;
  }

  .kb-stage-chip:hover {
    border-color: var(--kb-type-color);
    background: var(--kb-type-soft);
    color: var(--kb-type-color);
  }

  .kb-stage-chip-dot {
    width: 0.38rem;
    height: 0.38rem;
    border-radius: 50%;
    background: var(--kb-type-color);
  }

  @media (max-width: 38rem) {
    .kb-stage-tabs {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
