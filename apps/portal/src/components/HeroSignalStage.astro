---
import { withBase, withDocRoute } from '../lib/kb-data';

interface LayerSpec {
  index: number;
  shortTab: string;
  chips: string;
  colorClass: string;
  wavePath: string;
  links: Array<{ label: string; href: string; kind: string }>;
}

const layers: LayerSpec[] = [
  {
    index: 0,
    shortTab: '感知采样',
    chips: 'MPU6050 · K230 · LAN8720A · bxCAN',
    colorClass: 'kb-type-project',
    wavePath: 'M 0,9 Q 9,1 18,9 T 36,9 T 54,9 T 72,9',
    links: [
      { label: '反馈链路', href: withDocRoute('/topics/embedded/sensor-feedback-pipeline/'), kind: 'topic' },
      { label: 'flight', href: withDocRoute('/projects/flight/'), kind: 'project' },
      { label: 'mspm0g3507', href: withDocRoute('/projects/mspm0g3507/'), kind: 'project' },
    ],
  },
  {
    index: 1,
    shortTab: 'DMA 组帧',
    chips: 'UART IDLE · SPI DMA · CAN 分片 · CRC',
    colorClass: 'kb-type-topic',
    wavePath: 'M 0,13 L 10,13 L 10,3 L 22,3 L 22,13 L 34,13 L 34,3 L 50,3 L 50,13 L 60,13 L 60,3 L 72,3',
    links: [
      { label: '串流边界', href: withDocRoute('/topics/embedded/embedded-stream-framing/'), kind: 'topic' },
      { label: 'bootloader', href: withDocRoute('/projects/bootloader/'), kind: 'project' },
      { label: 'iwip', href: withDocRoute('/projects/iwip/'), kind: 'project' },
    ],
  },
  {
    index: 2,
    shortTab: 'RTOS 独占',
    chips: 'FreeRTOS · 互斥快照 · tcpip_thread',
    colorClass: 'kb-type-synthesis',
    wavePath: 'M 0,13 L 14,13 L 16,3 L 34,3 L 36,13 L 50,13 L 52,5 L 68,5 L 70,13',
    links: [
      { label: '总线所有权', href: withDocRoute('/topics/embedded/task-and-bus-ownership/'), kind: 'topic' },
      { label: 'ADR-0002', href: withDocRoute('/adr/ADR-0002-assign-sensor-bus-owner/'), kind: 'adr' },
      { label: 'watch', href: withDocRoute('/projects/watch/'), kind: 'project' },
    ],
  },
  {
    index: 3,
    shortTab: '暂存闭环',
    chips: '串级 PID · LVGL · W25Q16 + EEPROM',
    colorClass: 'kb-type-adr',
    wavePath: 'M 0,13 L 10,4 L 10,13 L 24,4 L 24,13 L 40,4 L 40,13 L 54,2 L 64,2 L 66,13 L 72,13',
    links: [
      { label: 'ADR-0001', href: withDocRoute('/adr/ADR-0001-stage-image-before-boot/'), kind: 'adr' },
      { label: 'TS-0001', href: withDocRoute('/troubleshooting/TS-0001-bootloader-update-phase/'), kind: 'troubleshooting' },
      { label: '全局图谱', href: withBase('/graph/'), kind: 'synthesis' },
    ],
  },
];

const svgBoxes = [
  { idx: 0, x: 18, label: '感知接口', sub: 'IMU · PHY', badge: 'L1', cls: 'kb-type-project' },
  { idx: 1, x: 139, label: 'DMA 组帧', sub: 'IDLE · CRC', badge: 'L2', cls: 'kb-type-topic' },
  { idx: 2, x: 260, label: 'RTOS 独占', sub: '快照 · 邮箱', badge: 'L3', cls: 'kb-type-synthesis' },
  { idx: 3, x: 381, label: '执行提交', sub: 'PID · Flash', badge: 'L4', cls: 'kb-type-adr' },
];
---

<div class="kb-stage-card kb-blueprint-canvas" data-hero-stage>
  <div class="kb-stage-topbar">
    <div class="kb-stage-status">
      <span class="kb-live-dot" aria-hidden="true"></span>
      <span>SIGNAL LOOP</span>
    </div>
    <div class="kb-stage-telemetry">
      <div class="kb-stage-progress" aria-hidden="true">
        <span class="kb-stage-progress-fill" data-stage-bar></span>
      </div>
      <span class="kb-stage-hint" data-stage-mode>AUTO</span>
    </div>
  </div>

  <div class="kb-stage-svg-wrap">
    <svg viewBox="0 0 500 214" role="group" aria-label="四层嵌入式固件信号流交互拓扑图">
      <defs>
        <linearGradient id="kb-bus-grad" x1="0%" y1="0%" x2="100%" y2="0%">
          <stop offset="0%" stop-color="var(--kb-accent)" />
          <stop offset="50%" stop-color="var(--kb-topic)" />
          <stop offset="100%" stop-color="var(--kb-adr)" />
        </linearGradient>
      </defs>

      <!-- Closed-Loop Feedback Arc (L4 -> L1) with Traveling Diagnostic Comet -->
      <path
        d="M 432 138 C 432 188, 68 188, 68 138"
        class="kb-stage-feedback-base"
        fill="none"
      />
      <path
        d="M 432 138 C 432 188, 68 188, 68 138"
        class="kb-stage-feedback-pulse"
        data-stage-arc="3"
        fill="none"
      />
      <path
        d="M 432 138 C 432 188, 68 188, 68 138"
        pathLength="100"
        class="kb-stage-feedback-comet"
        data-stage-comet
        fill="none"
      />
      <rect x="192" y="165" width="116" height="19" rx="9.5" class="kb-stage-arc-pill" />
      <text x="250" y="178" text-anchor="middle" class="kb-stage-arc-text">
        TS 实板诊断闭环
      </text>

      <!-- Forward Signal Buses (0->1, 1->2, 2->3) with Traveling Data Packets -->
      {[0, 1, 2].map((idx) => {
        const x1 = 114 + idx * 121;
        const x2 = 139 + idx * 121;
        return (
          <g>
            <line x1={x1} y1="86" x2={x2} y2="86" class="kb-stage-bus-base" />
            <line
              x1={x1}
              y1="86"
              x2={x2}
              y2="86"
              class="kb-stage-bus-flow"
              data-stage-edge={idx}
            />
            <line
              x1={x1}
              y1="86"
              x2={x2}
              y2="86"
              pathLength="100"
              class="kb-stage-bus-packet"
              style={`animation-delay: ${idx * -0.45}s;`}
              data-stage-packet={idx}
            />
            <polygon
              points={`${x2 - 5},82.5 ${x2 + 1},86 ${x2 - 5},89.5`}
              class="kb-stage-bus-arrow"
              data-stage-arrow={idx}
            />
          </g>
        );
      })}

      <!-- 4 Interactive Architecture Layer Modules with Live Micro-Oscilloscopes -->
      {
        svgBoxes.map((box) => (
          <g
            class={`kb-stage-node ${box.cls} ${box.idx === 0 ? 'is-active' : ''}`}
            data-stage-node={box.idx}
            tabindex="0"
            role="button"
            aria-label={`查看 ${box.badge} ${box.label}`}
          >
            <rect x={box.x} y="30" width="96" height="110" rx="12" class="kb-stage-node-glow" />
            <rect x={box.x} y="30" width="96" height="110" rx="12" class="kb-stage-node-card" />
            <rect x={box.x + 10} y="40" width="28" height="17" rx="5" class="kb-stage-node-tag" />
            <text x={box.x + 24} y="51.5" text-anchor="middle" class="kb-stage-node-tag-text">
              {box.badge}
            </text>
            <circle cx={box.x + 80} cy="48.5" r="7.5" class="kb-stage-node-led-halo" />
            <circle cx={box.x + 80} cy="48.5" r="3.8" class="kb-stage-node-led" />
            <text x={box.x + 48} y="76" text-anchor="middle" class="kb-stage-node-title">
              {box.label}
            </text>
            <text x={box.x + 48} y="92" text-anchor="middle" class="kb-stage-node-sub">
              {box.sub}
            </text>
            <line x1={box.x + 12} y1="102" x2={box.x + 84} y2="102" class="kb-stage-node-sep" />
            <!-- Live Oscilloscope Trace -->
            <g transform={`translate(${box.x + 12}, 111)`} aria-hidden="true">
              <path
                d={layers[box.idx].wavePath}
                pathLength="100"
                class="kb-stage-node-wave-bg"
                fill="none"
              />
              <path
                d={layers[box.idx].wavePath}
                pathLength="100"
                class="kb-stage-node-wave"
                style={`animation-delay: ${box.idx * -0.55}s;`}
                fill="none"
              />
            </g>
          </g>
        ))
      }
    </svg>
  </div>

  <!-- Synchronized Layer Switch Pills -->
  <div class="kb-stage-tabs" role="tablist" aria-label="架构层级切换">
    {layers.map((layer) => (
      <button
        type="button"
        role="tab"
        id={`kb-hero-tab-${layer.index}`}
        aria-controls={`kb-hero-panel-${layer.index}`}
        tabindex={layer.index === 0 ? 0 : -1}
        class={`kb-stage-tab ${layer.colorClass} ${layer.index === 0 ? 'is-active' : ''}`}
        aria-selected={layer.index === 0 ? 'true' : 'false'}
        data-stage-tab={layer.index}
      >
        <span class="kb-stage-tab-dot" aria-hidden="true"></span>
        <span>L{layer.index + 1} {layer.shortTab}</span>
      </button>
    ))}
  </div>

  <!-- Minimalist Telemetry Drawer (Zero Prose Paragraphs: Hardware Chips + Direct Jump Pills) -->
  <div class="kb-stage-drawer" aria-live="polite">
    {layers.map((layer) => (
      <div
        id={`kb-hero-panel-${layer.index}`}
        role="tabpanel"
        aria-labelledby={`kb-hero-tab-${layer.index}`}
        class={`kb-stage-panel ${layer.colorClass}`}
        data-stage-panel={layer.index}
        hidden={layer.index !== 0}
      >
        <code class="kb-stage-chips">{layer.chips}</code>
        <div class="kb-stage-panel-links">
          {layer.links.map((lnk) => (
            <a class={`kb-stage-chip kb-type-${lnk.kind}`} href={lnk.href}>
              <span class="kb-stage-chip-dot" aria-hidden="true"></span>
              {lnk.label}
              <span class="kb-chip-arrow" aria-hidden="true">→</span>
            </a>
          ))}
        </div>
      </div>
    ))}
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-hero-stage]').forEach((stage) => {
    const nodes = Array.from(stage.querySelectorAll<SVGGElement>('[data-stage-node]'));
    const tabs = Array.from(stage.querySelectorAll<HTMLButtonElement>('[data-stage-tab]'));
    const panels = Array.from(stage.querySelectorAll<HTMLElement>('[data-stage-panel]'));
    const edges = Array.from(stage.querySelectorAll<SVGLineElement>('[data-stage-edge]'));
    const packets = Array.from(stage.querySelectorAll<SVGLineElement>('[data-stage-packet]'));
    const arc = stage.querySelector<SVGPathElement>('[data-stage-arc]');
    const comet = stage.querySelector<SVGPathElement>('[data-stage-comet]');
    const modeEl = stage.querySelector<HTMLElement>('[data-stage-mode]');
    const barEl = stage.querySelector<HTMLElement>('[data-stage-bar]');

    let active = 0;
    let hovered = false;
    let focusedInside = false;
    const CYCLE_MS = 3400;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const isPaused = () => hovered || focusedInside;

    function restartProgressBar() {
      if (!barEl || reducedMotion) return;
      barEl.classList.remove('is-running');
      void barEl.offsetWidth;
      if (!isPaused()) {
        barEl.classList.add('is-running');
      }
    }

    function syncModeHint() {
      if (modeEl) {
        modeEl.textContent = isPaused() ? 'LOCK' : 'AUTO';
        modeEl.classList.toggle('is-locked', isPaused());
      }
      if (barEl) {
        barEl.classList.toggle('is-paused', isPaused());
      }
    }

    function setLayer(idx: number) {
      active = idx;
      nodes.forEach((n, i) => n.classList.toggle('is-active', i === idx));
      tabs.forEach((t, i) => {
        const on = i === idx;
        t.classList.toggle('is-active', on);
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
      });
      panels.forEach((p, i) => {
        p.hidden = i !== idx;
      });
      edges.forEach((edge, i) => {
        edge.classList.toggle('is-energized', i === idx || i === idx - 1);
      });
      packets.forEach((pkt, i) => {
        pkt.classList.toggle('is-energized', i === idx || i === idx - 1);
      });
      const feedbackActive = idx === 3 || idx === 0;
      arc?.classList.toggle('is-energized', feedbackActive);
      comet?.classList.toggle('is-energized', feedbackActive);
      restartProgressBar();
    }

    nodes.forEach((node, idx) => {
      node.addEventListener('mouseenter', () => setLayer(idx));
      node.addEventListener('click', () => setLayer(idx));
      node.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          setLayer(idx);
        }
      });
    });

    tabs.forEach((tab, idx) => {
      tab.addEventListener('click', () => setLayer(idx));
      tab.addEventListener('mouseenter', () => setLayer(idx));
      tab.addEventListener('keydown', (e) => {
        const next = {
          ArrowLeft: (idx - 1 + tabs.length) % tabs.length,
          ArrowRight: (idx + 1) % tabs.length,
          Home: 0,
          End: tabs.length - 1,
        }[e.key];
        if (next !== undefined) {
          e.preventDefault();
          setLayer(next);
          tabs[next].focus();
        }
      });
    });

    stage.addEventListener('mouseenter', () => {
      hovered = true;
      syncModeHint();
    });

    stage.addEventListener('mouseleave', () => {
      hovered = false;
      syncModeHint();
      restartProgressBar();
    });

    stage.addEventListener('focusin', () => {
      focusedInside = true;
      syncModeHint();
    });
    stage.addEventListener('focusout', (e) => {
      const next = e.relatedTarget as Node | null;
      focusedInside = Boolean(next && stage.contains(next));
      syncModeHint();
      if (!focusedInside) restartProgressBar();
    });

    setLayer(0);

    if (!reducedMotion) {
      window.setInterval(() => {
        if (!isPaused() && !document.hidden) {
          setLayer((active + 1) % 4);
        }
      }, CYCLE_MS);
    }
  });
</script>

<style>
  .kb-stage-card {
    display: flex;
    flex-direction: column;
    gap: 0.58rem;
    padding: 0.82rem 0.95rem 0.88rem;
    border-radius: 0.88rem;
    border: 1px solid var(--kb-border);
    box-shadow: var(--kb-shadow-sm);
  }

  .kb-stage-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    font-size: var(--sl-text-xs);
  }

  .kb-stage-status {
    display: inline-flex;
    align-items: center;
    gap: 0.42rem;
    font-family: var(--sl-font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--sl-color-gray-1);
  }

  .kb-live-dot {
    width: 0.48rem;
    height: 0.48rem;
    border-radius: 50%;
    background: var(--kb-topic);
    box-shadow: 0 0 0 3px var(--kb-topic-soft);
    animation: kbPulseSoft 2s ease-in-out infinite;
  }

  .kb-stage-telemetry {
    display: inline-flex;
    align-items: center;
    gap: 0.42rem;
  }

  .kb-stage-progress {
    width: 3.4rem;
    height: 3px;
    border-radius: 999px;
    background: var(--kb-surface-soft);
    overflow: hidden;
  }

  .kb-stage-progress-fill {
    display: block;
    width: 100%;
    height: 100%;
    transform-origin: left center;
    transform: scaleX(0);
    background: linear-gradient(90deg, var(--kb-accent), var(--kb-topic));
  }

  .kb-stage-progress-fill.is-running {
    animation: kbCycleSweep 3.4s linear forwards;
  }

  .kb-stage-progress-fill.is-paused {
    animation-play-state: paused;
    transform: scaleX(1);
  }

  @keyframes kbCycleSweep {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  .kb-stage-hint {
    padding: 0.06rem 0.38rem;
    border-radius: 0.26rem;
    border: 1px solid var(--kb-border);
    background: var(--kb-surface);
    color: var(--sl-color-gray-3);
    font-family: var(--sl-font-mono);
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .kb-stage-hint.is-locked {
    border-color: var(--kb-accent);
    color: var(--kb-accent);
    background: var(--kb-project-soft);
  }

  .kb-stage-svg-wrap svg {
    display: block;
    width: 100%;
    height: auto;
    user-select: none;
  }

  .kb-stage-bus-base {
    stroke: var(--kb-border-strong);
    stroke-width: 2;
  }

  .kb-stage-bus-flow {
    stroke: url(#kb-bus-grad);
    stroke-width: 2.6;
    stroke-dasharray: 5 5;
    opacity: 0.35;
    animation: kbDashFlow 1.05s linear infinite;
    transition: opacity 0.2s, stroke-width 0.2s;
  }

  .kb-stage-bus-flow.is-energized {
    opacity: 0.95;
    stroke-width: 3.2;
  }

  .kb-stage-bus-packet {
    stroke: var(--kb-accent);
    stroke-width: 4.2;
    stroke-linecap: round;
    stroke-dasharray: 18 82;
    opacity: 0.52;
    animation: kbPacketRun 1.35s linear infinite;
    transition: opacity 0.2s, stroke-width 0.2s;
  }

  .kb-stage-bus-packet.is-energized {
    stroke: var(--kb-topic);
    stroke-width: 5.4;
    opacity: 1;
    animation-duration: 0.78s;
  }

  @keyframes kbPacketRun {
    from {
      stroke-dashoffset: 100;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  .kb-stage-bus-arrow {
    fill: var(--kb-accent);
    opacity: 0.75;
  }

  .kb-stage-feedback-base {
    stroke: var(--kb-border);
    stroke-width: 1.4;
    stroke-dasharray: 4 4;
  }

  .kb-stage-feedback-pulse {
    stroke: var(--kb-troubleshooting);
    stroke-width: 1.8;
    stroke-dasharray: 6 6;
    opacity: 0.28;
    animation: kbDashFlow 1.5s linear infinite;
    transition: opacity 0.25s;
  }

  .kb-stage-feedback-pulse.is-energized {
    opacity: 0.88;
  }

  .kb-stage-feedback-comet {
    stroke: var(--kb-troubleshooting);
    stroke-width: 3.4;
    stroke-linecap: round;
    stroke-dasharray: 5 95;
    opacity: 0.55;
    animation: kbPacketRun 2.8s linear infinite;
    transition: opacity 0.25s, stroke-width 0.25s;
  }

  .kb-stage-feedback-comet.is-energized {
    opacity: 1;
    stroke-width: 4.4;
    animation-duration: 1.75s;
  }

  .kb-stage-arc-pill {
    fill: var(--kb-surface);
    stroke: var(--kb-border);
    stroke-width: 1;
  }

  .kb-stage-arc-text {
    fill: var(--sl-color-gray-3);
    font-family: var(--sl-font-mono);
    font-size: 9.5px;
    font-weight: 600;
  }

  .kb-stage-node {
    cursor: pointer;
    outline: none;
    transform-box: fill-box;
    transform-origin: center;
    transition: transform 0.24s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .kb-stage-node:is(:hover, :focus-visible, .is-active) {
    transform: translateY(-2.5px);
  }

  .kb-stage-node-glow {
    fill: var(--kb-type-soft);
    opacity: 0;
    transition: opacity 0.22s;
  }

  .kb-stage-node-card {
    fill: var(--kb-surface);
    stroke: var(--kb-border);
    stroke-width: 1.35;
    transition: stroke 0.2s, stroke-width 0.2s, fill 0.2s;
  }

  .kb-stage-node:is(:hover, :focus-visible, .is-active) .kb-stage-node-glow {
    opacity: 0.95;
  }

  .kb-stage-node:is(:hover, :focus-visible, .is-active) .kb-stage-node-card {
    fill: color-mix(in srgb, var(--kb-surface) 76%, var(--kb-type-soft));
    stroke: var(--kb-type-color);
    stroke-width: 2;
  }

  .kb-stage-node-tag {
    fill: var(--kb-type-soft);
  }

  .kb-stage-node-tag-text {
    fill: var(--kb-type-color);
    font-family: var(--sl-font-mono);
    font-size: 9.5px;
    font-weight: 700;
  }

  .kb-stage-node-led-halo {
    fill: var(--kb-type-color);
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
  }

  .kb-stage-node.is-active .kb-stage-node-led-halo {
    opacity: 0.28;
    animation: kbPulseSoft 1.8s ease-in-out infinite;
  }

  .kb-stage-node-led {
    fill: var(--kb-border-strong);
    transition: fill 0.2s;
  }

  .kb-stage-node.is-active .kb-stage-node-led {
    fill: var(--kb-type-color);
  }

  .kb-stage-node-title {
    fill: var(--sl-color-gray-1);
    font-size: 12px;
    font-weight: 700;
  }

  .kb-stage-node-sub {
    fill: var(--sl-color-gray-3);
    font-family: var(--sl-font-mono);
    font-size: 9.2px;
  }

  .kb-stage-node-sep {
    stroke: var(--kb-border);
    stroke-width: 1;
  }

  .kb-stage-node-wave-bg {
    stroke: var(--kb-border);
    stroke-width: 1.25;
    opacity: 0.55;
  }

  .kb-stage-node-wave {
    stroke: var(--kb-type-color);
    stroke-width: 1.85;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 34 66;
    opacity: 0.45;
    animation: kbPacketRun 2.2s linear infinite;
    transition: opacity 0.2s, stroke-width 0.2s;
  }

  .kb-stage-node:is(:hover, :focus-visible, .is-active) .kb-stage-node-wave {
    opacity: 1;
    stroke-width: 2.2;
    animation-duration: 1.15s;
  }

  .kb-stage-tabs {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.35rem;
  }

  .kb-stage-tab {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.28rem;
    padding: 0.26rem 0.38rem;
    border-radius: 0.45rem;
    border: 1px solid var(--kb-border);
    background: var(--kb-surface);
    color: var(--sl-color-gray-2);
    font: inherit;
    font-size: 0.7rem;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: border-color 0.16s, background 0.16s, color 0.16s, transform 0.16s;
  }

  .kb-stage-tab.is-active,
  .kb-stage-tab:hover {
