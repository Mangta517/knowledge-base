---
import DefaultFooter from '@astrojs/starlight/components/Footer.astro';
import MermaidInit from './MermaidInit.astro';
import { loadKbData, normalizeDocKey, withBase } from '../lib/kb-data';

const entryId = Astro.locals.starlightRoute?.entry?.id || '';
const cleanId = normalizeDocKey(entryId);
const { byRouteKey } = loadKbData();
const doc = byRouteKey.get(cleanId);

const isSplash = cleanId === '' || cleanId === 'index' || cleanId === 'graph' || cleanId === '404';
const shouldLoadMermaid = !isSplash && (doc ? (doc.mermaid_count ?? 1) > 0 : true);
---

<DefaultFooter {...Astro.props}><slot /></DefaultFooter>
<nav class="kb-footer-index" aria-label="公开索引">
  <span>公开数据与 AI 索引</span>
  <a href={withBase('/llms.txt')}>llms.txt</a>
  <a href={withBase('/llms-full.txt')}>llms-full.txt</a>
  <a href={withBase('/data/catalog.json')}>catalog.json</a>
  <a href={withBase('/data/graph.json')}>graph.json</a>
  <a href={withBase('/data/stats.json')}>stats.json</a>
  <a href={withBase('/graph/')}>知识图谱</a>
</nav>
{shouldLoadMermaid && <MermaidInit />}

<script>
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!reducedMotion) {
    document.documentElement.classList.add('kb-motion-ready');

    // 1. Staggered Scroll-Reveal for visual cards & sections
    const revealTargets = Array.from(
      document.querySelectorAll<HTMLElement>(
        '[data-kb-reveal], .kb-metric-card, .kb-track-card, .kb-project, .kb-bento-card, .kb-doc-spec-tile, .kb-backlinks li',
      ),
    );

    if ('IntersectionObserver' in window && revealTargets.length > 0) {
      const io = new IntersectionObserver(
        (entries) => {
          let batchIdx = 0;
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            const el = entry.target as HTMLElement;
            el.style.setProperty('--kb-reveal-delay', `${Math.min(batchIdx * 45, 270)}ms`);
            batchIdx++;
            el.classList.add('is-revealed');
            io.unobserve(el);
          });
        },
        { rootMargin: '0px 0px -32px 0px', threshold: 0.06 },
      );

      revealTargets.forEach((el) => {
        el.classList.add('kb-reveal-item');
        io.observe(el);
      });
    }

    // 2. Interactive Hardware Card Cursor Spotlight (--spot-x / --spot-y)
    let rafId = 0;
    let pendingEvent: PointerEvent | null = null;
    document.addEventListener(
      'pointermove',
      (e) => {
        pendingEvent = e;
        if (rafId) return;
        rafId = requestAnimationFrame(() => {
          rafId = 0;
          if (!pendingEvent) return;
          const card = (pendingEvent.target as Element | null)?.closest<HTMLElement>(
            '.kb-project, .kb-bento-card, .kb-track-card, .kb-metric-card, .kb-stage-card',
          );
          if (!card) return;
          const rect = card.getBoundingClientRect();
          card.style.setProperty('--spot-x', `${(pendingEvent.clientX - rect.left).toFixed(0)}px`);
          card.style.setProperty('--spot-y', `${(pendingEvent.clientY - rect.top).toFixed(0)}px`);
        });
      },
      { passive: true },
    );
  }
</script>

<style>
  .kb-footer-index {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.2rem 0.7rem;
    margin-top: 1.5rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--kb-border);
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-xs);
  }

  .kb-footer-index a {
    color: inherit;
    text-underline-offset: 0.18em;
  }

  .kb-footer-index a:hover {
    color: var(--kb-accent);
  }
</style>
