{
  "name": "@kb/portal",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "prepare:content": "node scripts/prepare-content.mjs",
    "typecheck": "node scripts/prepare-content.mjs && astro sync && tsc --noEmit",
    "test": "node --test tests/portal.test.mjs",
    "dev": "node scripts/prepare-content.mjs && astro dev --host 127.0.0.1 --port 4321",
