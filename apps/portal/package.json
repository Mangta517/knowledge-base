  },
  "dependencies": {
    "@astrojs/starlight": "^0.43.1",
    "astro": "^7.4.13",
    "mermaid": "^12.3.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
