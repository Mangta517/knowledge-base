    "preview": "astro preview --host 127.0.0.1 --port 4321"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.43.1",
    "@fontsource-variable/noto-sans-sc": "^5.3.1",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.1",
    "@fontsource/maple-mono": "^5.3.0",
    "astro": "^7.4.13",
    "lxgw-wenkai-screen-webfont": "^1.7.0",
    "mermaid": "^12.3.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
