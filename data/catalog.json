    {
      "title": "TS-0001 · Bootloader 收完 BIN 后未进入 APP",
      "description": "按接收、外部 Flash 暂存、EEPROM 提交、内部搬运与向量跳转定位 F407 更新失败阶段。",
      "type": "troubleshooting",
      "id": "TS-0001-bootloader-update-phase",
      "tags": [
        "bootloader",
        "eeprom",
        "can"
      ],
      "created": "2026-11-21",
      "updated": "2026-11-24",
      "ts_id": "TS-0001",
      "severity": "high",
      "related_projects": [
        "bootloader"
      ],
      "phases": [
        "接收与 CRC",
        "外部 Flash 暂存",
        "EEPROM 提交",
        "片内 Flash 搬运",
        "向量跳转"
      ],
      "root_cause": "公开联调中，LED APP 将 4480 字节 BIN 暂存到 W25Q16 0x001000，板上旧主引导仍只接受首扇区内的起点，在搬运前拒绝元数据。",
      "located_by": "用接收长度、CRC OK 和 Update save OK 排除本轮传输与保存失败，再用复位后的 APP metadata error 及其中的地址和长度锁定旧主引导的起点规则。",
      "route": "/troubleshooting/TS-0001-bootloader-update-phase/",
      "source_path": "wiki/troubleshooting/TS-0001-bootloader-update-phase.md",
      "word_count": 2015,
      "reading_minutes": 6,
      "mermaid_count": 1,
      "table_count": 3,
      "evidence_count": 6,
      "has_human_notes": false
    },
